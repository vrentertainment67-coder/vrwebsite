---
/** Tiered pricing card (editorial). */
interface Props {
  name: string;
  price: string;
  cadence?: string;
  blurb: string;
  features: string[];
  href: string;
  cta?: string;
  featured?: boolean;
}
const { name, price, cadence, blurb, features, href, cta = 'Book a call', featured = false } = Astro.props;
---

<div
  data-reveal
  class:list={[
    'flex flex-col rounded-xl border p-7 transition-transform hover:-translate-y-1',
    featured ? 'border-ink bg-ink text-paper' : 'border-hairline bg-surface text-ink',
  ]}
>
  <p class:list={['mono-label', featured && '!text-paper/70']}>{name}</p>
  <div class="mt-4 flex items-baseline gap-1">
    <span class="font-display text-4xl font-extrabold tracking-tight">{price}</span>
    {cadence && <span class:list={['text-sm', featured ? 'text-paper/70' : 'text-grey']}>{cadence}</span>}
  </div>
  <p class:list={['mt-3 text-sm', featured ? 'text-paper/80' : 'text-grey']}>{blurb}</p>

  <ul class="mt-6 flex-1 space-y-3 text-sm">
    {
      features.map((f) => (
        <li class="flex items-start gap-2.5">
          <span class:list={[featured ? 'text-paper' : 'text-accent']}>—</span>
          <span class:list={[featured ? 'text-paper/90' : 'text-ink']}>{f}</span>
        </li>
      ))
    }
  </ul>

  <a
    href={href}
    class:list={[
      'mt-7 inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 font-mono text-xs uppercase tracking-wider transition-colors',
      featured
        ? 'bg-paper text-ink hover:bg-accent hover:text-paper'
        : 'border border-ink text-ink hover:bg-ink hover:text-paper',
    ]}
  >
    {cta}
  </a>
</div>
