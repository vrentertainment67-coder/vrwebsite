---
/** Editorial work card: cover, client, descriptor, tag row, year tag. */
interface Props {
  href: string;
  client: string;
  title: string;
  descriptor: string;
  metricLabel?: string;
  metricAfter?: string;
  tags?: string[];
  year?: string;
  cover?: string;
}
const { href, client, title, descriptor, metricLabel, metricAfter, tags = [], year = '2026', cover } = Astro.props;
---

<a href={href} data-reveal class="group block">
  <!-- Cover -->
  <div class="relative aspect-[4/3] overflow-hidden rounded-lg border border-hairline bg-surface">
    {
      cover ? (
        <img
          src={cover}
          alt={`${title} — ${client}`}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        /* TODO(VIC): supply a work cover image */
        <div class="flex h-full w-full items-center justify-center bg-[#ece9e1]">
          <span class="font-display text-3xl font-extrabold tracking-tight text-grey/40">{title}</span>
        </div>
      )
    }
    <span class="mono-label absolute right-3 top-3 rounded bg-paper/85 px-2 py-1">YR/ {year}</span>
  </div>

  <!-- Meta -->
  <div class="mt-4 flex items-start justify-between gap-4">
    <div>
      <p class="mono-label">{client}</p>
      <h3 class="mt-1 font-display text-2xl font-extrabold tracking-tight text-ink transition-colors group-hover:text-accent">
        {title}
      </h3>
      <p class="mt-1 text-sm text-grey">{descriptor}</p>
    </div>
    {
      metricAfter && (
        <div class="shrink-0 text-right">
          <p class="font-display text-3xl font-extrabold tracking-tight text-accent">{metricAfter}</p>
          {metricLabel && <p class="mono-label">{metricLabel}</p>}
        </div>
      )
    }
  </div>

  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.map((t) => <span class="chip">{t}</span>)}
      </div>
    )
  }
</a>
