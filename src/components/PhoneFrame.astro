---
/** Phone device frame for vertical / social content. */
interface Props {
  src?: string;
  alt?: string;
  label?: string;
}
const { src, alt = 'Phone screenshot', label } = Astro.props;
---

<div class="mx-auto w-full max-w-[260px]">
  <div class="relative aspect-[9/19] overflow-hidden rounded-[2rem] border-[6px] border-[#26241f] bg-surface shadow-2xl shadow-black/50">
    <!-- notch -->
    <span class="absolute left-1/2 top-2 z-10 h-1.5 w-16 -translate-x-1/2 rounded-full bg-[#26241f]" aria-hidden="true"></span>
    {
      src ? (
        <img src={src} alt={alt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-[#1c1b18] px-4 text-center">
          <span class="font-mono text-[0.6rem] uppercase tracking-wider text-grey/60">{label ?? 'Vertical content'} · TODO</span>
        </div>
      )
    }
  </div>
</div>
