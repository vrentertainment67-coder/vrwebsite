---
import { SERVICES } from '@/data/services';
const flagship = SERVICES.find((s) => s.flagship)!;
const rest = SERVICES.filter((s) => !s.flagship);
---

<section id="studio" class="cap">
  <div class="head vr-reveal">
    <h2 class="h2">The website is the flagship. <span class="it">Not the whole studio.</span></h2>
    <p class="sub">
      VR Entertainment has spent nineteen years inside the night economy — programming the events,
      making the content and managing the talent. The intelligent website is simply the sharpest
      tool we’ve built for it.
    </p>
  </div>

  <div class="grid">
    <a href={flagship.href} class="pillar is-flagship vr-lift vr-reveal">
      <div class="p-top">
        <span class="n mono">{flagship.n}</span>
        <span class="tag mono">{flagship.tag}</span>
      </div>
      <h3 class="p-name">{flagship.name}</h3>
      <p class="p-body">{flagship.body}</p>
      <ul class="points">
        {flagship.points.map((pt) => <li class="mono">{pt}</li>)}
      </ul>
      <span class="go">Explore intelligent websites <span aria-hidden="true">→</span></span>
    </a>

    {
      rest.map((s) => (
        <a href={`/studio#${s.anchor}`} class="pillar is-link vr-lift vr-reveal">
          <div class="p-top">
            <span class="n mono">{s.n}</span>
            <span class="tag mono">{s.tag}</span>
          </div>
          <h3 class="p-name">{s.name}</h3>
          <p class="p-body">{s.body}</p>
          <ul class="points">
            {s.points.map((pt) => <li class="mono">{pt}</li>)}
          </ul>
          <span class="go">Learn more <span aria-hidden="true">→</span></span>
        </a>
      ))
    }
  </div>

  <p class="foot vr-reveal">
    One studio, four ways in. <a href="/studio">See the full studio →</a>
  </p>
</section>

<style>
  .cap {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .head { display: flex; flex-wrap: wrap; gap: 24px 80px; align-items: end; }
  .h2 {
    flex: 1 1 560px;
    margin: 0;
    font-weight: 500;
    font-size: var(--text-h2-sm);
    line-height: 0.98;
    letter-spacing: var(--tracking-heading);
  }
  .it { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: var(--tracking-serif); color: var(--accent); }
  .sub { flex: 1 1 300px; margin: 0; font-size: 17px; line-height: 1.6; color: var(--muted); }
  .mono { font-family: var(--font-mono); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-frame);
    background: var(--card);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--dur-theme) ease, border-color var(--dur-theme) ease;
  }
  .is-flagship {
    grid-column: 1 / -1;
    border-color: color-mix(in oklab, var(--accent) 55%, var(--line));
    box-shadow: 0 50px 100px -60px rgba(0, 0, 0, 0.45);
  }

  .p-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .n { font-size: 12px; color: var(--accent); }
  .tag {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
  }
  .is-flagship .tag { color: var(--accent); border-color: color-mix(in oklab, var(--accent) 45%, var(--line)); }

  .p-name { margin: 0; font-weight: 500; font-size: 30px; letter-spacing: -0.03em; line-height: 1; }
  .is-flagship .p-name { font-size: clamp(34px, 4vw, 52px); }
  .p-body { margin: 0; font-size: 16px; line-height: 1.55; color: var(--muted); max-width: 60ch; }
  .is-flagship .p-body { font-size: 18px; max-width: 46ch; }

  .points { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .points li {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 6px 12px;
  }

  .go {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--fg);
  }
  .is-flagship:hover .go,
  .is-link:hover .go { color: var(--accent); }

  .foot { margin: 0; font-size: 15px; color: var(--muted); }
  .foot a { color: var(--fg); text-decoration: underline; text-underline-offset: 4px; }
  .foot a:hover { color: var(--accent); }

  @media (min-width: 900px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .is-flagship {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      grid-template-areas: 'top points' 'name points' 'body go';
      align-items: start;
      column-gap: 48px;
      row-gap: 20px;
    }
    .is-flagship .p-top { grid-area: top; }
    .is-flagship .p-name { grid-area: name; }
    .is-flagship .p-body { grid-area: body; align-self: end; }
    .is-flagship .points { grid-area: points; align-content: start; }
    .is-flagship .go { grid-area: go; margin-top: 0; align-self: end; justify-self: start; }
  }
</style>
