---
interface Props {
  title: string;
  blurb: string;
  href: string;
}
const { title, blurb, href } = Astro.props;
---

<a
  href={href}
  data-reveal
  class="glow-gold group relative flex flex-col rounded-md border border-white/10 bg-white/[0.02] p-6"
>
  <h3 class="font-display text-2xl text-off-white transition-colors group-hover:text-gold">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-warm-grey">{blurb}</p>
  <span class="mt-4 text-sm font-medium text-gold opacity-70 transition-opacity group-hover:opacity-100">Learn more →</span>
</a>
