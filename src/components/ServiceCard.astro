---
interface Props {
  title: string;
  blurb: string;
  href: string;
  index?: string;
  tags?: string[];
}
const { title, blurb, href, index, tags = [] } = Astro.props;
---

<a
  href={href}
  data-reveal
  class="group grid grid-cols-[auto_1fr_auto] items-center gap-x-5 gap-y-2 border-b border-hairline py-6 transition-colors hover:border-ink"
>
  {index && <span class="section-index self-start pt-1">/{index}</span>}
  <div>
    <h3 class="font-display text-2xl font-extrabold tracking-tight text-ink transition-colors group-hover:text-accent">
      {title}
    </h3>
    <p class="mt-1 max-w-xl text-sm text-grey">{blurb}</p>
    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map((t) => <span class="chip">{t}</span>)}
        </div>
      )
    }
  </div>
  <span class="mono-label self-start pt-1 transition-transform group-hover:translate-x-1">→</span>
</a>
