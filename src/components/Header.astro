---
import { NAV } from '@/data/site';
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props { variant?: 'home' | 'inner'; active?: string; }
const { variant = 'home', active } = Astro.props;
---

<header class="hdr">
  <a href="/" class="brand" aria-label="VR Entertainment, home">
    <span class="brand-mark">VR</span>
    <span class="brand-sub">Entertainment</span>
  </a>

  <nav aria-label="Main" class="nav">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          aria-current={active === item.href ? 'page' : undefined}
          class:list={['nav-link', active === item.href && 'is-active']}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  {
    variant === 'home' ? (
      <a href="/contact" class="pill">
        <span class="vr-pulse dot" aria-hidden="true" />
        Start a project
      </a>
    ) : (
      <ThemeToggle compact={true} />
    )
  }
</header>

<style>
  .hdr {
    max-width: var(--container);
    margin: 0 auto;
    padding: 22px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 36px;
  }
  .brand {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
  }
  .brand-mark {
    font-family: var(--font-serif);
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .brand-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    font-size: 14px;
    letter-spacing: 0.01em;
  }
  .nav-link { text-decoration: none; }
  .nav-link.is-active { text-decoration: underline; text-underline-offset: 6px; }
  .pill {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--btn-h-sm);
    padding: 0 20px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    font-size: 14px;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
