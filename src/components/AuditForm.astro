---
/** Free-audit lead magnet form → POST /api/audit. */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<form data-audit-form class="mx-auto w-full max-w-xl text-left">
  <div class:list={['grid gap-4', compact ? '' : 'sm:grid-cols-2']}>
    <div>
      <label for="audit-name" class="mb-1 block text-xs uppercase tracking-widest text-warm-grey">Name</label>
      <input id="audit-name" name="name" type="text" autocomplete="name"
        class="w-full rounded-sm border border-white/15 bg-white/5 px-3 py-2.5 text-off-white placeholder:text-warm-grey/50 focus:border-gold focus:outline-none" />
    </div>
    <div>
      <label for="audit-email" class="mb-1 block text-xs uppercase tracking-widest text-warm-grey">Email <span class="text-signal-red">*</span></label>
      <input id="audit-email" name="email" type="email" required autocomplete="email"
        class="w-full rounded-sm border border-white/15 bg-white/5 px-3 py-2.5 text-off-white placeholder:text-warm-grey/50 focus:border-gold focus:outline-none" />
    </div>
    <div>
      <label for="audit-website" class="mb-1 block text-xs uppercase tracking-widest text-warm-grey">Website</label>
      <input id="audit-website" name="website_url" type="url" placeholder="https://"
        class="w-full rounded-sm border border-white/15 bg-white/5 px-3 py-2.5 text-off-white placeholder:text-warm-grey/50 focus:border-gold focus:outline-none" />
    </div>
    <div>
      <label for="audit-ig" class="mb-1 block text-xs uppercase tracking-widest text-warm-grey">Instagram</label>
      <input id="audit-ig" name="instagram" type="text" placeholder="@yourhandle"
        class="w-full rounded-sm border border-white/15 bg-white/5 px-3 py-2.5 text-off-white placeholder:text-warm-grey/50 focus:border-gold focus:outline-none" />
    </div>
    <div class="sm:col-span-2">
      <label for="audit-segment" class="mb-1 block text-xs uppercase tracking-widest text-warm-grey">What are you?</label>
      <select id="audit-segment" name="segment"
        class="w-full rounded-sm border border-white/15 bg-white/5 px-3 py-2.5 text-off-white focus:border-gold focus:outline-none">
        <option value="" class="bg-near-black">Select…</option>
        <option value="venue" class="bg-near-black">Venue / Club</option>
        <option value="artist" class="bg-near-black">Artist / DJ</option>
        <option value="brand" class="bg-near-black">Hospitality / Beverage Brand</option>
        <option value="event" class="bg-near-black">Festival / Event</option>
        <option value="other" class="bg-near-black">Other</option>
      </select>
    </div>
  </div>

  <!-- honeypot -->
  <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  <button type="submit" class="btn-cta mt-6 w-full justify-center sm:w-auto">Get my free audit</button>
  <p data-audit-msg class="mt-3 text-sm text-warm-grey" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.querySelector('form[data-audit-form]') as HTMLFormElement | null;
  const msg = document.querySelector('[data-audit-msg]') as HTMLElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msg) return;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    msg.classList.remove('text-gold', 'text-signal-red');
    msg.textContent = 'Sending…';
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('/api/audit', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json();
      if (out.ok) {
        form.reset();
        msg.textContent = '✓ Got it. We’ll send your audit within 48 hours.';
        msg.classList.add('text-gold');
      } else {
        msg.textContent = out.error || 'Something went wrong.';
        msg.classList.add('text-signal-red');
      }
    } catch {
      msg.textContent = 'Network error — please try again.';
      msg.classList.add('text-signal-red');
    } finally {
      btn.disabled = false;
    }
  });
</script>
