---
/**
 * Drag-to-reveal before/after image comparison (light editorial).
 * Keyboard-operable via a range input; touch + mouse via the same input.
 * Uses neutral placeholder panels when no image is supplied (TODO: real assets).
 */
interface Props {
  before?: string;
  after?: string;
  beforeLabel?: string;
  afterLabel?: string;
  alt?: string;
}
const {
  before,
  after,
  beforeLabel = 'Before',
  afterLabel = 'After',
  alt = 'Before and after comparison',
} = Astro.props;
const id = 'ba-' + Math.random().toString(36).slice(2, 8);
---

<div
  class="ba-slider relative aspect-[16/10] w-full select-none overflow-hidden rounded-lg border border-hairline bg-surface"
  data-ba
  role="group"
  aria-label={alt}
>
  <!-- AFTER (full, underneath) -->
  <div class="absolute inset-0">
    {
      after ? (
        <img src={after} alt={`${alt} — after`} class="h-full w-full object-cover" loading="lazy" decoding="async" />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-[#1c1b18]">
          <span class="font-display text-5xl font-light tracking-normal text-accent/60">AFTER</span>
        </div>
      )
    }
    <span class="mono-label absolute bottom-3 right-3 rounded bg-paper/85 px-2 py-1 !text-accent">{afterLabel}</span>
  </div>

  <!-- BEFORE (clipped, on top) -->
  <div class="ba-before absolute inset-0" style="clip-path: inset(0 50% 0 0);" data-ba-before>
    {
      before ? (
        <img src={before} alt={`${alt} — before`} class="h-full w-full object-cover grayscale" loading="lazy" decoding="async" />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-[#232220]">
          <span class="font-display text-5xl font-light tracking-normal text-grey/50">BEFORE</span>
        </div>
      )
    }
    <span class="mono-label absolute bottom-3 left-3 rounded bg-paper/85 px-2 py-1">{beforeLabel}</span>
  </div>

  <!-- Divider line + handle -->
  <div class="ba-divider pointer-events-none absolute inset-y-0" style="left: 50%;" data-ba-divider>
    <div class="absolute inset-y-0 -ml-px w-0.5 bg-ink"></div>
    <div class="absolute top-1/2 -ml-5 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-ink text-paper shadow-lg">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 7l-5 5 5 5V7zm8 0v10l5-5-5-5z"/></svg>
    </div>
  </div>

  <label for={id} class="sr-only">Reveal slider</label>
  <input
    id={id}
    type="range"
    min="0"
    max="100"
    value="50"
    class="ba-range absolute inset-0 h-full w-full cursor-ew-resize appearance-none bg-transparent opacity-0"
    data-ba-range
    aria-label={alt}
  />
</div>

<script>
  document.querySelectorAll('[data-ba]').forEach((root) => {
    const range = root.querySelector('[data-ba-range]') as HTMLInputElement;
    const before = root.querySelector('[data-ba-before]') as HTMLElement;
    const divider = root.querySelector('[data-ba-divider]') as HTMLElement;
    if (!range || !before || !divider) return;
    const update = () => {
      const v = Number(range.value);
      before.style.clipPath = `inset(0 ${100 - v}% 0 0)`;
      divider.style.left = `${v}%`;
    };
    range.addEventListener('input', update);
    update();
  });
</script>
