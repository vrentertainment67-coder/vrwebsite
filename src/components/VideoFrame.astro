---
/** Video-player device frame. Clicking opens the modal with id `modalId`. */
interface Props {
  title: string;
  poster?: string;
  modalId: string;
  label?: string;
}
const { title, poster, modalId, label = 'The Vic Fix' } = Astro.props;
---

<button
  data-modal-open={modalId}
  class="group relative block aspect-video w-full overflow-hidden rounded-xl border border-hairline bg-surface shadow-2xl shadow-black/40"
  aria-label={`Play ${title}`}
>
  {
    poster ? (
      <img src={poster} alt={title} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
    ) : (
      <span class="absolute inset-0 bg-[#161513]"></span>
    )
  }
  <span class="absolute inset-0 grid place-items-center">
    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-ink text-paper transition-transform group-hover:scale-110">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    </span>
  </span>
  <span class="mono-label absolute bottom-3 left-3">{label}</span>
</button>
