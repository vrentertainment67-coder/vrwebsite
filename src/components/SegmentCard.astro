---
interface Props {
  title: string;
  pitch: string;
  href: string;
  index?: string;
}
const { title, pitch, href, index } = Astro.props;
---

<a
  href={href}
  data-reveal
  class="group flex items-center justify-between gap-6 border-b border-hairline py-7 transition-colors hover:border-ink"
>
  <div class="flex items-baseline gap-5">
    {index && <span class="section-index shrink-0">{index}</span>}
    <div>
      <h3 class="font-display text-[clamp(1.6rem,3.5vw,2.5rem)] font-extrabold leading-none tracking-tight text-ink transition-colors group-hover:text-accent">
        {title}
      </h3>
      <p class="mt-2 text-grey">{pitch}</p>
    </div>
  </div>
  <span class="mono-label shrink-0 transition-transform group-hover:translate-x-1">→</span>
</a>
