---
interface Props {
  index?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
}
const { index, eyebrow, title, subtitle } = Astro.props;
---

<section class="border-b border-hairline bg-paper pb-16 pt-36 lg:pt-44">
  <div class="mx-auto max-w-[1400px] px-5 lg:px-10">
    <p class="flex items-center gap-3">
      {index && <span class="section-index">// {index}</span>}
      {eyebrow && <span class="mono-label">{eyebrow}</span>}
    </p>
    <h1 class="mt-6 max-w-5xl font-display text-[clamp(2.6rem,8vw,6rem)] font-light leading-[0.95] tracking-normal text-ink">
      {title}
    </h1>
    {subtitle && <p class="mt-6 max-w-2xl text-lg text-grey md:text-xl">{subtitle}</p>}
    <slot />
  </div>
</section>
