---
import { SITE } from '@/data/site';
interface Props { variant?: 'home' | 'inner'; }
const { variant = 'home' } = Astro.props;
---

{
  variant === 'home' ? (
    <footer class="ft">
      <div class="ft-inner">
        <div class="wordmark">
          VR <span class="it">Entertainment</span>
        </div>
        <div class="row">
          <span class="addr">{SITE.address.line}</span>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={`tel:${SITE.phoneE164}`}>{SITE.phoneDisplay}</a>
          <a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={SITE.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
    </footer>
  ) : (
    <footer class="ft-c">
      <span class="mark">VR <span class="it">Entertainment</span></span>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={`tel:${SITE.phoneE164}`}>{SITE.phoneDisplay}</a>
      <a href={SITE.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
    </footer>
  )
}

<style>
  .ft { border-top: 1px solid var(--line); }
  .ft-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 56px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .wordmark {
    font-family: var(--font-serif);
    font-size: clamp(64px, 14vw, 220px);
    line-height: 0.85;
    letter-spacing: -0.04em;
  }
  .wordmark .it { font-style: italic; color: var(--accent); }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
    font-size: 14px;
    color: var(--muted);
  }
  .row a { text-decoration: none; }
  .row .addr { margin-right: auto; }

  .ft-c {
    border-top: 1px solid var(--line);
    max-width: var(--container);
    margin: 0 auto;
    padding: 40px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    font-size: 14px;
    color: var(--muted);
  }
  .ft-c a { text-decoration: none; }
  .ft-c .mark {
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--fg);
    margin-right: auto;
  }
  .ft-c .it { font-style: italic; color: var(--accent); }
</style>
