---
// Moving credential marquee. Items repeated twice for a seamless loop.
interface Props {
  items?: string[];
}
const {
  items = [
    'Universal Music',
    'Flingit',
    '18 Countries',
    'Featured on The Vic Fix',
    '19 Years On The Decks',
    '₹1L/mo Retainer',
  ],
} = Astro.props;
const doubled = [...items, ...items];
---

<div class="rule overflow-hidden border-b border-hairline bg-paper py-5" aria-hidden="true">
  <div class="marquee-track">
    {
      doubled.map((item) => (
        <span class="mx-7 flex items-center gap-7 whitespace-nowrap font-mono text-sm uppercase tracking-wider text-grey">
          {item}
          <span class="h-1 w-1 rounded-full bg-accent"></span>
        </span>
      ))
    }
  </div>
</div>
