---
/** Strategy-call / contact form → POST /api/lead. */
interface Props {
  source?: string;
  segment?: string;
}
const { source = 'contact', segment = '' } = Astro.props;
---

<form data-lead-form class="w-full max-w-xl text-left">
  <input type="hidden" name="source" value={source} />
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="lead-name" class="mono-label mb-1.5 block">Name *</label>
      <input id="lead-name" name="name" type="text" required autocomplete="name" class="field" />
    </div>
    <div>
      <label for="lead-email" class="mono-label mb-1.5 block">Email *</label>
      <input id="lead-email" name="email" type="email" required autocomplete="email" class="field" />
    </div>
    <div>
      <label for="lead-phone" class="mono-label mb-1.5 block">Phone</label>
      <input id="lead-phone" name="phone" type="tel" autocomplete="tel" class="field" />
    </div>
    <div>
      <label for="lead-segment" class="mono-label mb-1.5 block">You are a…</label>
      <select id="lead-segment" name="segment" class="field">
        <option value="">Select…</option>
        <option value="venue" selected={segment === 'venue'}>Venue / Club</option>
        <option value="artist" selected={segment === 'artist'}>Artist / DJ</option>
        <option value="brand" selected={segment === 'brand'}>Hospitality / Beverage Brand</option>
        <option value="event" selected={segment === 'event'}>Festival / Event</option>
        <option value="other" selected={segment === 'other'}>Other</option>
      </select>
    </div>
    <div class="sm:col-span-2">
      <label for="lead-message" class="mono-label mb-1.5 block">What do you want to grow?</label>
      <textarea id="lead-message" name="message" rows="4" class="field"></textarea>
    </div>
  </div>

  <!-- honeypot -->
  <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  <button type="submit" class="btn mt-6">Book a Strategy Call</button>
  <p data-lead-msg class="mono-label mt-3" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.querySelector('form[data-lead-form]') as HTMLFormElement | null;
  const msg = document.querySelector('[data-lead-msg]') as HTMLElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msg) return;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    msg.textContent = 'Sending…';
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json();
      if (out.ok) {
        form.reset();
        msg.textContent = '✓ Got it. We’ll be in touch within one business day.';
      } else {
        msg.textContent = out.error || 'Something went wrong.';
      }
    } catch {
      msg.textContent = 'Network error — please try again.';
    } finally {
      btn.disabled = false;
    }
  });
</script>
