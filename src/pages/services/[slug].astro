---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';
import { SERVICES, PROCESS, SITE } from '@/lib/site';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const others = SERVICES.filter((x) => x.slug !== s.slug).slice(0, 3);

const schema = [
  {
    '@type': 'Service',
    name: s.title,
    description: s.blurb,
    provider: { '@id': `${SITE.url}/#organization` },
    areaServed: 'IN',
    url: `${SITE.url}/services/${s.slug}`,
  },
];
---

<Layout
  title={`${s.title} — VR Entertainment`}
  description={s.blurb}
  path={`/services/${s.slug}`}
  schema={schema}
>
  <PageHero eyebrow="Service" title={s.title} subtitle={s.blurb}>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/contact" class="btn-cta">Book a Strategy Call</a>
      <a href="/work" class="btn-ghost">See the work</a>
    </div>
  </PageHero>

  <!-- TODO: full service copy — deliverables, packages, FAQs, proof. Scaffold below. -->
  <section class="mx-auto max-w-3xl px-5 py-20 lg:px-8">
    <div data-reveal>
      <p class="eyebrow mb-5">How it works</p>
      <h2 class="font-display text-4xl text-off-white">Audit → Strategy → Build → Grow</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-4">
        {
          PROCESS.map((step, i) => (
            <div class="rounded-md border border-white/10 bg-white/[0.02] p-4">
              <span class="font-display text-3xl text-gold/50">0{i + 1}</span>
              <p class="mt-1 font-display text-2xl text-off-white">{step}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-deep-black py-20">
    <div class="mx-auto flex max-w-3xl flex-col items-center px-5 text-center lg:px-8" data-reveal>
      <h2 class="font-display text-4xl text-off-white">Let’s build it.</h2>
      <div class="mt-8 flex justify-center"><LeadForm source="service-page" /></div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <h2 class="mb-6 font-display text-3xl text-off-white">More services</h2>
    <div class="grid gap-5 sm:grid-cols-3">
      {
        others.map((o) => (
          <a href={`/services/${o.slug}`} class="glow-gold rounded-md border border-white/10 bg-white/[0.02] p-6">
            <h3 class="font-display text-2xl text-off-white">{o.title}</h3>
            <p class="mt-2 text-sm text-warm-grey">{o.blurb}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
