---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';
import { SERVICES, PROCESS, SITE } from '@/lib/site';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const others = SERVICES.filter((x) => x.slug !== s.slug).slice(0, 3);

const schema = [
  {
    '@type': 'Service',
    name: s.title,
    description: s.blurb,
    provider: { '@id': `${SITE.url}/#organization` },
    areaServed: 'IN',
    url: `${SITE.url}/services/${s.slug}`,
  },
];
---

<Layout title={`${s.title} — VR Entertainment`} description={s.blurb} path={`/services/${s.slug}`} schema={schema}>
  <PageHero eyebrow="Service" title={s.title} subtitle={s.blurb}>
    <div class="mt-8 flex flex-wrap items-center gap-5">
      <a href="/contact" class="btn">Book a Strategy Call</a>
      <a href="/work" class="btn-text">See the work →</a>
    </div>
  </PageHero>

  <!-- TODO(VIC): full service copy — deliverables, packages, FAQs, proof. -->
  <section class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10 lg:py-28">
    <p class="mono-label" data-reveal>// How it works</p>
    <div class="mt-8 grid gap-px overflow-hidden rounded-lg border border-hairline bg-hairline sm:grid-cols-4">
      {PROCESS.map((step, i) => (
        <div data-reveal class="bg-paper p-6">
          <span class="section-index">0{i + 1}</span>
          <p class="mt-3 font-display text-2xl font-light tracking-normal text-ink">{step}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-hairline bg-surface">
    <div class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10">
      <h2 class="font-display text-[clamp(2rem,5vw,3.25rem)] font-light tracking-normal text-ink" data-reveal>Let’s build it.</h2>
      <div class="mt-8" data-reveal data-reveal-delay="0.1"><LeadForm source="service-page" /></div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 py-16 lg:px-10">
    <p class="mono-label mb-6" data-reveal>// More services</p>
    <div>
      {others.map((o, i) => (
        <a href={`/services/${o.slug}`} data-reveal class="group flex items-center justify-between border-b border-hairline py-5 transition-colors hover:border-ink">
          <h3 class="font-display text-xl font-light tracking-normal text-ink transition-colors group-hover:text-accent">{o.title}</h3>
          <span class="mono-label transition-transform group-hover:translate-x-1">→</span>
        </a>
      ))}
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
