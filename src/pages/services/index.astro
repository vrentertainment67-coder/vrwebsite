---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { SERVICES, SITE } from '@/lib/site';

const serviceTags: Record<string, string[]> = {
  'web-design-development': ['Astro', 'Tailwind', 'SEO', 'CMS'],
  'artist-dj-websites': ['EPK', 'Booking', 'Mixes'],
  'seo-and-local-seo': ['Local', 'Technical', 'Content'],
  'social-content-and-reels': ['Reels', 'Shooting', 'Editing'],
  'video-and-podcast-production': ['Film', 'Audio', 'Studio'],
  'branding-and-press-kits': ['Identity', 'EPK', 'Logo'],
  'event-and-nightlife-marketing': ['Campaigns', 'Ads', 'Footfall'],
  'consulting-and-growth-strategy': ['Roadmap', 'Audit', 'Growth'],
};

const schema = [
  {
    '@type': 'Service',
    serviceType: 'Nightlife & hospitality growth services',
    provider: { '@id': `${SITE.url}/#organization` },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Services',
      itemListElement: SERVICES.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.title, url: `${SITE.url}/services/${s.slug}` },
      })),
    },
  },
];
---

<Layout
  title="Services — VR Entertainment"
  description="Web design, SEO, content, video, branding and growth strategy for venues, artists and hospitality brands. Everything you need to grow. Nothing you don’t."
  path="/services"
  schema={schema}
>
  <PageHero
    index="02"
    eyebrow="The Arsenal"
    title="Everything you need to grow. Nothing you don’t."
    subtitle="A full stack of services built by people who live in the night economy."
  />

  <section class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10 lg:py-28">
    <div>
      {SERVICES.map((s, i) => (
        <ServiceCard title={s.title} blurb={s.blurb} href={`/services/${s.slug}`} index={`0${i + 1}`} tags={serviceTags[s.slug] ?? []} />
      ))}
    </div>
    <div class="mt-12" data-reveal>
      <a href="/contact" class="btn">Book a Strategy Call</a>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
