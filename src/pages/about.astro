---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Marquee from '@/components/Marquee.astro';
import { SITE } from '@/lib/site';
---

<Layout
  title="About — VR Entertainment"
  description="Founded by DJ Vic (Vikas Naik): 19+ years DJing, 18+ countries, a Universal Music partnership, and the creator of The Vic Fix. We don’t just market nightlife — we’re part of it."
  path="/about"
>
  <PageHero
    index="—"
    eyebrow="About"
    title="We’re part of the night. Not just selling to it."
    subtitle="VR Entertainment is a growth agency for nightlife, hospitality, and the artists who power them — founded by DJ Vic."
  />

  <Marquee />

  <section class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1fr]">
      <div data-reveal>
        <p class="mono-label">// The founder</p>
        <h2 class="mt-4 font-display text-[clamp(2rem,4.5vw,3.25rem)] font-light leading-[0.98] tracking-normal text-ink">
          DJ Vic — Vikas Naik
        </h2>
      </div>
      <div data-reveal data-reveal-delay="0.1">
        <p class="text-lg text-grey">{SITE.founder.bio}</p>
        <p class="mt-4 text-lg text-grey">
          19 years behind the decks. 18 countries. A Universal Music partnership. A podcast the
          industry actually watches. When we build your brand, we build it from the inside.
        </p>
        <a href="/contact" class="btn mt-8">Work with us</a>
      </div>
    </div>

    <!-- Leadership — Ritika Mishra (CFO). TODO(VIC): add a photo to /brand/ritika-mishra.jpg -->
    <div class="rule mt-20 pt-12" data-reveal>
      <p class="mono-label mb-5">// Leadership</p>
      <div class="flex items-center gap-5">
        <span class="flex h-16 w-16 items-center justify-center rounded-full bg-hairline font-display text-2xl font-light text-ink">RM</span>
        <div>
          <h3 class="font-display text-2xl font-light tracking-normal text-ink">Ritika Mishra</h3>
          <p class="mono-label">Chief Financial Officer</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
