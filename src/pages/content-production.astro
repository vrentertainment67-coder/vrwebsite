---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
---
<Layout title="Content & Production | VR Entertainment" description="End-to-end production services for brands and creators, from strategy through post-production, from VR Entertainment.">
  <section class="bg-background px-6 py-[100px] lg:px-8">
    <div class="mx-auto grid max-w-[1200px] gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-terracotta font-[300]">CONTENT & PRODUCTION</p>
        <h1 class="mt-6 font-display text-[52px] leading-tight text-text-primary">We produce content that builds audiences.</h1>
        <p class="mt-6 text-[18px] leading-[1.8] text-text-secondary font-[300]">End-to-end production — from strategy through post-production — for brands and creators who are serious about their presence.</p>
      </div>
      <div class="rounded-[6px] border border-border bg-surface p-10">
        <p class="text-[14px] uppercase tracking-[0.18em] text-text-tertiary">Production, simplified</p>
        <p class="mt-6 text-[16px] leading-[1.8] text-text-primary font-[300]">We move from concept to launch with a single team, so your project does not lose momentum in handoffs.</p>
      </div>
    </div>
  </section>

  <section class="bg-surface px-6 py-[100px] lg:px-8">
    <div class="mx-auto grid max-w-[1200px] gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-[28px] font-display text-text-primary">What we produce</h2>
        <div class="mt-8 space-y-4 text-[16px] leading-8 text-text-secondary font-[300]">
          <p>Short-form content series (Instagram, YouTube Shorts, Reels)</p>
          <p>Long-form YouTube content and documentary formats</p>
          <p>Podcast production (full post-production pipeline)</p>
          <p>Brand films and event coverage</p>
          <p>Social media content systems (monthly retainer)</p>
        </div>
      </div>
      <div class="rounded-[6px] border border-border bg-background p-10">
        <h2 class="text-[28px] font-display text-text-primary">What "end-to-end" means</h2>
        <p class="mt-6 text-[16px] leading-[1.8] text-text-secondary font-[300]">We handle strategy, scripting, production oversight, editing, motion, sound, and distribution strategy. You don't coordinate between vendors.</p>
      </div>
    </div>
    <div class="mx-auto mt-12 max-w-[840px] rounded-[6px] border border-border bg-background p-10">
      <p class="text-[16px] leading-[1.8] text-text-primary font-[500]">Projects start from ₹50,000. Monthly retainers from ₹40,000.</p>
      <p class="mt-4 text-[16px] leading-[1.8] text-text-secondary font-[300]">We scope every project individually. No package menus.</p>
    </div>
  </section>

  <section class="bg-background px-6 py-[100px] lg:px-8">
    <div class="mx-auto max-w-[840px] text-center">
      <a href="/contact?type=content" class="inline-flex rounded-[8px] border border-accent px-8 py-4 text-[14px] font-[500] text-accent hover:bg-accent hover:text-background transition duration-300 ease-in-out">Start a Project →</a>
    </div>
  </section>
</Layout>
