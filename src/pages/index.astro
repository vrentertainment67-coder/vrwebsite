---
import Layout from '@/layouts/Layout.astro';
import Marquee from '@/components/Marquee.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import Clock from '@/components/Clock.astro';
import SegmentCard from '@/components/SegmentCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import WorkCard from '@/components/WorkCard.astro';
import PricingCard from '@/components/PricingCard.astro';
import KineticStatement from '@/components/KineticStatement.astro';
import BeforeAfterSlider from '@/components/BeforeAfterSlider.astro';
import AuditForm from '@/components/AuditForm.astro';
import { SEGMENTS, SERVICES, PROCESS, SITE } from '@/lib/site';
import { CASE_STUDIES } from '@/lib/work';
import { getReadClient } from '@/lib/supabase';

// Lowercase, editorial. Word-by-word reveal keeps real spaces (no jam bug).
const heroWords = 'we build the brands that own the night.'.split(' ');

// Per-service tag chips (technical metadata).
const serviceTags: Record<string, string[]> = {
  'web-design-development': ['Astro', 'Tailwind', 'SEO', 'CMS'],
  'artist-dj-websites': ['EPK', 'Booking', 'Mixes'],
  'seo-and-local-seo': ['Local', 'Technical', 'Content'],
  'social-content-and-reels': ['Reels', 'Shooting', 'Editing'],
  'video-and-podcast-production': ['Film', 'Audio', 'Studio'],
  'branding-and-press-kits': ['Identity', 'EPK', 'Logo'],
  'event-and-nightlife-marketing': ['Campaigns', 'Ads', 'Footfall'],
  'consulting-and-growth-strategy': ['Roadmap', 'Audit', 'Growth'],
};

// Work tags + year (TODO(metrics): 38→92 / 68% being verified before publish).
const workTags: Record<string, string[]> = {
  djvicofficial: ['Web Design', 'SEO', 'Astro'],
  flingit: ['Product', 'Platform', 'Build'],
  'the-vic-fix': ['Video', 'Distribution', 'Growth'],
};

const schema = [
  {
    '@type': 'PodcastSeries',
    name: 'The Vic Fix',
    url: `${SITE.url}/the-vic-fix`,
    description: 'India’s nightlife, on the record — a documentary platform on the people who run the night.',
  },
  {
    '@type': 'Service',
    serviceType: 'Nightlife & hospitality growth marketing',
    provider: { '@id': `${SITE.url}/#organization` },
    areaServed: 'IN',
  },
];

// Published testimonials (Supabase). Section hidden entirely if none.
interface Testimonial {
  name: string;
  role: string | null;
  company: string | null;
  quote: string;
  avatar: string | null;
}
let testimonials: Testimonial[] = [];
try {
  const supabase = getReadClient();
  const { data } = await supabase
    .from('testimonials')
    .select('name, role, company, quote, avatar')
    .eq('published', true)
    .order('sort_order', { ascending: true });
  testimonials = data ?? [];
} catch {
  testimonials = [];
}
---

<Layout
  title="VR Entertainment — We build the brands that own the night"
  description="Websites, content and growth systems for venues, artists and hospitality brands — built by people who actually live in the nightlife industry."
  path="/"
  schema={schema}
>
  <!-- ─────────────── HERO ─────────────── -->
  <section class="border-b border-hairline bg-paper px-5 pt-36 pb-16 lg:px-10 lg:pt-48">
    <div class="mx-auto max-w-[1400px]">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="flex items-center gap-3">
          <span class="section-index">// VR ENTERTAINMENT</span>
          <span class="mono-label">Growth agency for the night economy</span>
        </p>
        <Clock />
      </div>

      <h1
        data-words
        class="mt-10 font-display text-[clamp(3rem,12vw,11rem)] font-extrabold leading-[0.88] tracking-[-0.03em] text-ink"
      >
        {heroWords.map((w, i) => (
          <Fragment>{i > 0 ? ' ' : ''}<span class="word inline-block">{w}</span></Fragment>
        ))}
      </h1>

      <div class="mt-10 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <p class="max-w-xl text-lg text-grey md:text-xl" data-reveal data-reveal-delay="0.5">
          Websites, content and growth systems for venues, artists and hospitality brands — built by
          people who actually live in the industry.
        </p>
        <div class="flex flex-wrap items-center gap-5" data-reveal data-reveal-delay="0.7">
          <a href="/contact" class="btn">Book a Strategy Call</a>
          <a href="/work" class="btn-text">See the Work →</a>
        </div>
      </div>

      <p class="mono-label mt-12 border-t border-hairline pt-5">
        Universal Music · 18 Countries · Featured on The Vic Fix · 19 Years On The Decks
      </p>
    </div>
  </section>

  <!-- Trust marquee -->
  <Marquee />

  <!-- ─────────────── // 01 WHO WE HELP ─────────────── -->
  <section class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
    <SectionLabel index="01" label="Who We Help" title="Who we build for." />
    <div class="mt-12">
      {SEGMENTS.map((s, i) => (
        <SegmentCard title={s.title} pitch={s.pitch} href={`/who-we-help/${s.slug}`} index={`0${i + 1}`} />
      ))}
    </div>
  </section>

  <!-- ─────────────── // 02 SERVICES ─────────────── -->
  <section class="border-t border-hairline bg-surface">
    <div class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
      <SectionLabel
        index="02"
        label="The Arsenal"
        title="Everything you need to grow. Nothing you don’t."
      />
      <div class="mt-12">
        {SERVICES.map((s, i) => (
          <ServiceCard
            title={s.title}
            blurb={s.blurb}
            href={`/services/${s.slug}`}
            index={`0${i + 1}`}
            tags={serviceTags[s.slug] ?? []}
          />
        ))}
      </div>
      <div class="mt-10" data-reveal>
        <a href="/services" class="btn-outline">Explore Services</a>
      </div>
    </div>
  </section>

  <!-- ─────────────── // 03 WORK ─────────────── -->
  <section class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
    <SectionLabel index="03" label="Work" title="Receipts." description="The brands we’ve built, and what changed after." />

    <!-- Featured before/after (djvicofficial) -->
    <div class="mt-12 grid items-center gap-8 lg:grid-cols-2" data-reveal>
      <BeforeAfterSlider
        beforeLabel="Old site · SEO 38"
        afterLabel="New build · SEO 92"
        alt="djvicofficial.com redesign before and after"
      />
      <div>
        <p class="mono-label">djvicofficial.com — YR/ 2026</p>
        <h3 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-ink">SEO score 38 → 92.</h3>
        {/* TODO(metrics): verify 38 → 92 before publish */}
        <p class="mt-3 text-lg text-grey">Built on Astro. Ranking and booking.</p>
        <a href="/work/djvicofficial" class="btn-text mt-5">Read the case study →</a>
      </div>
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
      {CASE_STUDIES.map((c) => (
        <WorkCard
          href={`/work/${c.slug}`}
          client={c.client}
          title={c.title}
          descriptor={c.summary}
          metricLabel={c.metricLabel}
          metricAfter={c.metricAfter}
          tags={workTags[c.slug] ?? []}
          year="2026"
        />
      ))}
    </div>
    <div class="mt-12" data-reveal>
      <a href="/work" class="btn-outline">See all work</a>
    </div>
  </section>

  <!-- ─────────────── KINETIC STATEMENT ─────────────── -->
  <KineticStatement
    lines={[
      { text: 'we listen.' },
      { text: 'we build.' },
      { text: 'we grow' },
      { text: 'the night economy.', accent: true },
    ]}
  />

  <!-- ─────────────── // 04 THE UNFAIR ADVANTAGE ─────────────── -->
  <section class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1fr]">
      <SectionLabel index="04" label="The Unfair Advantage" />
      <div data-reveal>
        <h2 class="font-display text-[clamp(2rem,5vw,3.75rem)] font-extrabold leading-[0.98] tracking-tight text-ink">
          We don’t just market the nightlife industry. We’re part of it.
        </h2>
        <p class="mt-6 max-w-2xl text-lg text-grey">
          19 years behind the decks. 18 countries. A Universal Music partnership. A podcast that the
          industry actually watches. When we build your brand, we build it from the inside.
        </p>
      </div>
    </div>
  </section>

  <!-- ─────────────── THE VIC FIX ─────────────── -->
  <section class="border-y border-hairline bg-surface">
    <div class="mx-auto grid max-w-[1400px] items-center gap-10 px-5 py-20 lg:grid-cols-2 lg:px-10">
      <div data-reveal>
        <p class="mono-label">// Our platform</p>
        <h2 class="mt-4 font-display text-[clamp(2rem,5vw,3.5rem)] font-extrabold leading-[0.98] tracking-tight text-ink">
          The Vic Fix — India’s nightlife, on the record.
        </h2>
        <p class="mt-5 max-w-xl text-lg text-grey">
          Our own documentary platform on the people who run the night. It’s how we prove what we
          can build for you.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-5">
          <a href="/the-vic-fix" class="btn">Watch</a>
          <a href="/contact" class="btn-text">Partner with the show →</a>
        </div>
      </div>
      <div data-reveal data-reveal-delay="0.15" class="flex items-center justify-center rounded-lg border border-hairline bg-paper p-12">
        <img
          src="/brand/the-vic-fix-logo.png"
          alt="The Vic Fix"
          width="320"
          height="180"
          loading="lazy"
          decoding="async"
          class="max-h-28 w-auto object-contain"
        />
      </div>
    </div>
  </section>

  <!-- ─────────────── // 05 PROCESS ─────────────── -->
  <section class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
    <SectionLabel index="05" label="Process" title="How we work." />
    <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-hairline bg-hairline md:grid-cols-4">
      {PROCESS.map((step, i) => (
        <div data-reveal class="bg-paper p-7">
          <span class="section-index">0{i + 1}</span>
          <h3 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-ink">{step}</h3>
        </div>
      ))}
    </div>
  </section>

  <!-- ─────────────── // 06 PRICING ─────────────── -->
  <section class="border-t border-hairline bg-surface">
    <div class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
      <SectionLabel
        index="06"
        label="Pricing"
        title="Pick a starting point."
        description="Fixed-scope kits to launch fast, or a monthly retainer to compound. Book a call for custom scope."
      />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {/* TODO(VIC): set fixed prices for the two kits when confirmed. */}
        <PricingCard
          name="DJ Website in a Box"
          price="On request"
          cadence="fixed scope"
          blurb="A booking-ready artist site that works while you tour."
          features={['Cinematic artist site', 'EPK + booking section', 'Mobile-first, SEO-ready', 'Domain + deploy handled']}
          href="/dj-website-in-a-box"
          cta="Start my site"
        />
        <PricingCard
          name="Growth Retainer"
          price="From ₹1L"
          cadence="/mo"
          blurb="The compounding option — we run growth end-to-end, every month."
          features={['Web + SEO + content', 'Reels & campaigns', 'Monthly strategy', 'Priority on new work']}
          href="/contact"
          cta="Book a call"
          featured={true}
        />
        <PricingCard
          name="Venue Launch Kit"
          price="On request"
          cadence="fixed scope"
          blurb="Everything a new venue needs to open loud."
          features={['Brand + press kit', 'Site with events + bookings', 'Local SEO', 'Launch campaign']}
          href="/venue-launch-kit"
          cta="Launch my venue"
        />
      </div>
    </div>
  </section>

  <!-- ─────────────── TESTIMONIALS (hidden if none published) ─────────────── -->
  {
    testimonials.length > 0 && (
      <section class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
        <SectionLabel label="Testimonials" title="What they say after." />
        <div
          class:list={[
            'mt-12 grid gap-6',
            testimonials.length === 1 ? 'max-w-2xl' : testimonials.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3',
          ]}
        >
          {testimonials.map((t) => (
            <figure data-reveal class="rounded-lg border border-hairline bg-surface p-7">
              <blockquote class="text-lg text-ink">“{t.quote}”</blockquote>
              <figcaption class="mt-5 flex items-center gap-3">
                {t.avatar ? (
                  <img src={t.avatar} alt={t.name} width="40" height="40" loading="lazy" class="h-10 w-10 rounded-full object-cover" />
                ) : (
                  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-hairline font-mono text-sm text-ink">
                    {t.name.charAt(0)}
                  </span>
                )}
                <span class="mono-label">
                  {t.name}
                  {t.role && <>, {t.role}</>}
                  {t.company && <> · {t.company}</>}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <!-- ─────────────── FREE AUDIT ─────────────── -->
  <section id="free-audit" class="border-t border-hairline bg-surface">
    <div class="mx-auto grid max-w-[1400px] gap-12 px-5 py-24 lg:grid-cols-2 lg:px-10 lg:py-32">
      <div data-reveal>
        <p class="mono-label">// Free audit</p>
        <h2 class="mt-4 font-display text-[clamp(2rem,5vw,3.5rem)] font-extrabold leading-[0.98] tracking-tight text-ink">
          Not ready to talk? Get the free audit.
        </h2>
        <p class="mt-5 max-w-md text-lg text-grey">
          We’ll show you the three things hurting your bookings or footfall right now. No call required.
        </p>
      </div>
      <div data-reveal data-reveal-delay="0.15">
        <AuditForm />
      </div>
    </div>
  </section>

  <!-- ─────────────── FINAL CTA ─────────────── -->
  <section class="mx-auto max-w-[1400px] px-5 py-28 lg:px-10 lg:py-36">
    <div data-reveal>
      <p class="mono-label">// Limited intake</p>
      <h2 class="mt-5 max-w-4xl font-display text-[clamp(2.5rem,7vw,6rem)] font-extrabold leading-[0.95] tracking-tight text-ink">
        We take three new clients a quarter. Make it count.
      </h2>
      <a href="/contact" class="btn mt-10">Book a Strategy Call</a>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
