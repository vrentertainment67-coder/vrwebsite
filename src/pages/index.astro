---
import Layout from '@/layouts/Layout.astro';
import Marquee from '@/components/Marquee.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import Clock from '@/components/Clock.astro';
import SegmentCard from '@/components/SegmentCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import PricingCard from '@/components/PricingCard.astro';
import KineticStatement from '@/components/KineticStatement.astro';
import BeforeAfterSlider from '@/components/BeforeAfterSlider.astro';
import BrowserFrame from '@/components/BrowserFrame.astro';
import PhoneFrame from '@/components/PhoneFrame.astro';
import VideoFrame from '@/components/VideoFrame.astro';
import VideoModal from '@/components/VideoModal.astro';
import AuditForm from '@/components/AuditForm.astro';
import { SEGMENTS, SERVICES, PROCESS, SITE } from '@/lib/site';
import { getTestimonials } from '@/lib/content';

// Lowercase, editorial. Word-by-word reveal keeps real spaces (no jam bug).
const heroWords = 'we build the brands that own the night.'.split(' ');

// Per-service tag chips (technical metadata).
const serviceTags: Record<string, string[]> = {
  'web-design-development': ['Astro', 'Tailwind', 'SEO', 'CMS'],
  'artist-dj-websites': ['EPK', 'Booking', 'Mixes'],
  'seo-and-local-seo': ['Local', 'Technical', 'Content'],
  'social-content-and-reels': ['Reels', 'Shooting', 'Editing'],
  'video-and-podcast-production': ['Film', 'Audio', 'Studio'],
  'branding-and-press-kits': ['Identity', 'EPK', 'Logo'],
  'event-and-nightlife-marketing': ['Campaigns', 'Ads', 'Footfall'],
  'consulting-and-growth-strategy': ['Roadmap', 'Audit', 'Growth'],
};

// Work tags + year (TODO(metrics): 38→92 / 68% being verified before publish).
const workTags: Record<string, string[]> = {
  djvicofficial: ['Web Design', 'SEO', 'Astro'],
  flingit: ['Product', 'Platform', 'Build'],
  'the-vic-fix': ['Video', 'Distribution', 'Growth'],
};

const schema = [
  {
    '@type': 'PodcastSeries',
    name: 'The Vic Fix',
    url: `${SITE.url}/the-vic-fix`,
    description: 'India’s nightlife, on the record — a documentary platform on the people who run the night.',
  },
  {
    '@type': 'Service',
    serviceType: 'Nightlife & hospitality growth marketing',
    provider: { '@id': `${SITE.url}/#organization` },
    areaServed: 'IN',
  },
];

// Published testimonials via the centralized data layer. Section hidden if none.
const testimonials = await getTestimonials();
---

<Layout
  title="VR Entertainment — We build the brands that own the night"
  description="Websites, content and growth systems for venues, artists and hospitality brands — built by people who actually live in the nightlife industry."
  path="/"
  schema={schema}
>
  <!-- ─────────────── HERO (Mercury: full-bleed, centered, email+pill) ─────────────── -->
  <section class="relative flex min-h-[100svh] items-center justify-center overflow-hidden border-b border-hairline">
    <!-- Atmospheric background. TODO(VIC): drop a full-bleed night-economy photo at /hero-bg.jpg -->
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute inset-0 bg-paper"></div>
      <div class="absolute inset-0 bg-[radial-gradient(120%_85%_at_50%_-10%,rgba(194,65,12,0.12),transparent_55%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(100%_100%_at_50%_120%,rgba(0,0,0,0.55),transparent)]"></div>
    </div>

    <div class="mx-auto max-w-3xl px-5 py-32 text-center">
      <p class="mono-label flex items-center justify-center gap-2">
        <span class="section-index">// VR Entertainment</span> — Growth Agency
      </p>

      <h1
        data-words
        class="mx-auto mt-8 font-display text-[clamp(2.75rem,8vw,6.5rem)] font-light leading-[1.02] tracking-[0.01em] text-ink"
      >
        {heroWords.map((w, i) => (
          <Fragment>{i > 0 ? ' ' : ''}<span class="word inline-block">{w}</span></Fragment>
        ))}
      </h1>

      <p class="mx-auto mt-7 max-w-xl text-lg text-grey" data-reveal data-reveal-delay="0.4">
        Websites, content and growth systems for venues, artists and hospitality brands — built by
        people who actually live in the industry.
      </p>

      <!-- Joined email input + pill (posts to /api/audit) -->
      <form data-hero-form class="mx-auto mt-9 flex w-full max-w-md items-stretch" data-reveal data-reveal-delay="0.6">
        <label for="hero-email" class="sr-only">Email</label>
        <input
          id="hero-email"
          name="email"
          type="email"
          required
          placeholder="you@email.com"
          class="w-full rounded-l-full border border-r-0 border-lead/60 bg-transparent px-5 py-3.5 text-ink placeholder:text-grey/55 focus:border-accent focus:outline-none"
        />
        <button type="submit" class="btn shrink-0" style="border-top-left-radius:0;border-bottom-left-radius:0">Get started</button>
        <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      </form>
      <p data-hero-msg class="mono-label mt-3 h-4" role="status" aria-live="polite"></p>

      <div class="mt-5"><a href="/work" class="btn-text">See the work →</a></div>

      <div class="mt-14 flex items-center justify-center"><Clock /></div>
      <p class="mono-label mt-4">Universal Music · 18 Countries · Featured on The Vic Fix · 19 Years</p>
    </div>
  </section>

  <!-- Trust marquee -->
  <Marquee />

  <!-- ─────────────── // 01 WHO WE HELP (feature-list) ─────────────── -->
  <section class="mx-auto max-w-[1200px] px-5 py-28 lg:px-8 lg:py-36">
    <SectionLabel index="01" label="Who We Help" title="Who we build for." />
    <div class="mt-14">
      {SEGMENTS.map((s, i) => (
        <SegmentCard title={s.title} pitch={s.pitch} href={`/who-we-help/${s.slug}`} index={`0${i + 1}`} />
      ))}
    </div>
  </section>

  <!-- ─────────────── // 02 SERVICES (feature-list) ─────────────── -->
  <section class="border-t border-hairline bg-surface">
    <div class="mx-auto max-w-[1200px] px-5 py-28 lg:px-8 lg:py-36">
      <SectionLabel
        index="02"
        label="The Arsenal"
        title="Everything you need to grow. Nothing you don’t."
      />
      <div class="mt-12">
        {SERVICES.map((s, i) => (
          <ServiceCard
            title={s.title}
            blurb={s.blurb}
            href={`/services/${s.slug}`}
            index={`0${i + 1}`}
            tags={serviceTags[s.slug] ?? []}
          />
        ))}
      </div>
      <div class="mt-10" data-reveal>
        <a href="/services" class="btn-outline">Explore Services</a>
      </div>
    </div>
  </section>

  <!-- ─────────────── // 03 WORK ─────────────── -->
  <section class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
    <SectionLabel index="03" label="Work" title="Receipts." description="The brands we’ve built, and what changed after." />

    <!-- Featured: djvicofficial.com — before/after slider inside a browser frame -->
    <div class="mt-12 grid items-center gap-10 lg:grid-cols-2" data-reveal>
      <BrowserFrame url="djvicofficial.com">
        <BeforeAfterSlider
          beforeLabel="Old site · SEO 38"
          afterLabel="New build · SEO 92"
          alt="djvicofficial.com redesign before and after"
        />
      </BrowserFrame>
      <div>
        <p class="mono-label">djvicofficial.com — YR/ 2026</p>
        <h3 class="mt-2 font-display text-3xl font-light tracking-normal text-ink">SEO score 38 → 92.</h3>
        {/* TODO(metrics): verify 38 → 92 before publish */}
        <p class="mt-3 text-lg text-grey">Built on Astro. Ranking and booking.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {workTags['djvicofficial'].map((t) => <span class="chip">{t}</span>)}
        </div>
        <a href="/work/djvicofficial" class="btn-text mt-5">Read the case study →</a>
      </div>
    </div>

    <!-- Flingit (browser frame) + The Vic Fix (video frame → modal) -->
    <div class="mt-16 grid gap-10 md:grid-cols-2" data-reveal>
      <div>
        {/* TODO(VIC): supply a flingit.in full-page screenshot */}
        <BrowserFrame url="flingit.in" tall={true} />
        <div class="mt-4 flex items-start justify-between gap-4">
          <div>
            <p class="mono-label">Flingit — YR/ 2026</p>
            <a href="/work/flingit" class="font-display text-2xl font-light tracking-normal text-ink transition-colors hover:text-accent">Flingit</a>
            <p class="mt-1 text-sm text-grey">A full nightlife rewards platform — built, shipped, run end-to-end.</p>
          </div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">{workTags['flingit'].map((t) => <span class="chip">{t}</span>)}</div>
      </div>

      <div>
        <VideoFrame title="The Vic Fix" modalId="vicfix-home" label="The Vic Fix" />
        <div class="mt-4">
          <p class="mono-label">The Vic Fix — YR/ 2026</p>
          <a href="/work/the-vic-fix" class="font-display text-2xl font-light tracking-normal text-ink transition-colors hover:text-accent">The Vic Fix</a>
          <p class="mt-1 text-sm text-grey">68% episode-view growth, Season 1 → Season 2.</p>
          <div class="mt-3 flex flex-wrap gap-2">{workTags['the-vic-fix'].map((t) => <span class="chip">{t}</span>)}</div>
        </div>
      </div>
    </div>

    <div class="mt-12" data-reveal>
      <a href="/work" class="btn-outline">See all work</a>
    </div>
  </section>

  <!-- Vic Fix video modal (shared by the work frame + the feature block) -->
  <VideoModal id="vicfix-home" title="The Vic Fix" watchUrl={SITE.socials.youtube} />

  <!-- ─────────────── KINETIC STATEMENT ─────────────── -->
  <KineticStatement
    lines={[
      { text: 'we listen.' },
      { text: 'we build.' },
      { text: 'we grow' },
      { text: 'the night economy.', accent: true },
    ]}
  />

  <!-- ─────────────── // 04 THE UNFAIR ADVANTAGE ─────────────── -->
  <section class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1fr]">
      <SectionLabel index="04" label="The Unfair Advantage" />
      <div data-reveal>
        <h2 class="font-display text-[clamp(2rem,5vw,3.75rem)] font-light leading-[0.98] tracking-normal text-ink">
          We don’t just market the nightlife industry. We’re part of it.
        </h2>
        <p class="mt-6 max-w-2xl text-lg text-grey">
          19 years behind the decks. 18 countries. A Universal Music partnership. A podcast that the
          industry actually watches. When we build your brand, we build it from the inside.
        </p>

        <!-- Count-up stats -->
        <div class="mt-12 grid grid-cols-3 gap-px overflow-hidden rounded-lg border border-hairline bg-hairline">
          <div class="bg-paper p-6">
            <p class="font-display text-[clamp(2.5rem,5vw,4rem)] font-light tracking-normal text-ink">
              <span data-countup="19">19</span>
            </p>
            <p class="mono-label mt-1">Years on the decks</p>
          </div>
          <div class="bg-paper p-6">
            <p class="font-display text-[clamp(2.5rem,5vw,4rem)] font-light tracking-normal text-ink">
              <span data-countup="18">18</span>
            </p>
            <p class="mono-label mt-1">Countries</p>
          </div>
          <div class="bg-paper p-6">
            <p class="font-display text-[clamp(2.5rem,5vw,4rem)] font-light tracking-normal text-accent">
              <span data-countup="92">92</span>
            </p>
            <p class="mono-label mt-1">SEO score · djvic</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────── THE VIC FIX ─────────────── -->
  <section class="border-y border-hairline bg-surface">
    <div class="mx-auto grid max-w-[1400px] items-center gap-10 px-5 py-20 lg:grid-cols-2 lg:px-10">
      <div data-reveal>
        <p class="mono-label">// Our platform</p>
        <h2 class="mt-4 font-display text-[clamp(2rem,5vw,3.5rem)] font-light leading-[0.98] tracking-normal text-ink">
          The Vic Fix — India’s nightlife, on the record.
        </h2>
        <p class="mt-5 max-w-xl text-lg text-grey">
          Our own documentary platform on the people who run the night. It’s how we prove what we
          can build for you.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-5">
          <button data-modal-open="vicfix-home" class="btn">Watch</button>
          <a href="/contact" class="btn-text">Partner with the show →</a>
        </div>
      </div>
      <button
        data-modal-open="vicfix-home"
        data-reveal
        data-reveal-delay="0.15"
        class="group relative flex aspect-video items-center justify-center overflow-hidden rounded-lg border border-hairline bg-paper p-12"
        aria-label="Play The Vic Fix"
      >
        <img
          src="/brand/the-vic-fix-logo.png"
          alt="The Vic Fix"
          width="320"
          height="180"
          loading="lazy"
          decoding="async"
          class="max-h-24 w-auto object-contain opacity-90"
        />
        <span class="absolute bottom-3 right-3 flex h-12 w-12 items-center justify-center rounded-full bg-ink text-paper transition-transform group-hover:scale-110">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </button>
    </div>
  </section>

  <!-- ─────────────── SOCIAL / REELS (phone frames) ─────────────── -->
  <section class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
    <SectionLabel
      label="Social & Reels"
      title="Content that lives where the night does."
      description="Scroll-stopping vertical content, shot by people who live in the scene."
    />
    <div class="mt-12 grid grid-cols-2 gap-6 md:grid-cols-4">
      {/* TODO(VIC): drop reel screenshots / clips into these phone frames */}
      {[1, 2, 3, 4].map((n) => (
        <div data-reveal data-reveal-delay={`${n * 0.05}`}>
          <PhoneFrame label="Reel" />
        </div>
      ))}
    </div>
    <div class="mt-10" data-reveal>
      <a href="/services/social-content-and-reels" class="btn-outline">Social Content & Reels →</a>
    </div>
  </section>

  <!-- ─────────────── // 05 PROCESS (feature-list) ─────────────── -->
  <section class="mx-auto max-w-[1200px] px-5 py-28 lg:px-8 lg:py-36">
    <SectionLabel index="05" label="Process" title="How we work." />
    <div class="mt-14">
      {PROCESS.map((step, i) => (
        <div data-reveal class="flex items-baseline gap-6 border-b border-lead/30 py-7">
          <span class="section-index shrink-0">0{i + 1}</span>
          <h3 class="font-display text-[clamp(1.75rem,4vw,3rem)] font-light leading-[1.05] tracking-normal text-ink">{step}</h3>
        </div>
      ))}
    </div>
  </section>

  <!-- ─────────────── // 06 PRICING ─────────────── -->
  <section class="border-t border-hairline bg-surface">
    <div class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
      <SectionLabel
        index="06"
        label="Pricing"
        title="Pick a starting point."
        description="Fixed-scope kits to launch fast, or a monthly retainer to compound. Book a call for custom scope."
      />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {/* TODO(VIC): set fixed prices for the two kits when confirmed. */}
        <PricingCard
          name="DJ Website in a Box"
          price="On request"
          cadence="fixed scope"
          blurb="A booking-ready artist site that works while you tour."
          features={['Cinematic artist site', 'EPK + booking section', 'Mobile-first, SEO-ready', 'Domain + deploy handled']}
          href="/dj-website-in-a-box"
          cta="Start my site"
        />
        <PricingCard
          name="Growth Retainer"
          price="From ₹1L"
          cadence="/mo"
          blurb="The compounding option — we run growth end-to-end, every month."
          features={['Web + SEO + content', 'Reels & campaigns', 'Monthly strategy', 'Priority on new work']}
          href="/contact"
          cta="Book a call"
          featured={true}
        />
        <PricingCard
          name="Venue Launch Kit"
          price="On request"
          cadence="fixed scope"
          blurb="Everything a new venue needs to open loud."
          features={['Brand + press kit', 'Site with events + bookings', 'Local SEO', 'Launch campaign']}
          href="/venue-launch-kit"
          cta="Launch my venue"
        />
      </div>
    </div>
  </section>

  <!-- ─────────────── TESTIMONIALS (hidden if none published) ─────────────── -->
  {
    testimonials.length > 0 && (
      <section class="mx-auto max-w-[1400px] px-5 py-24 lg:px-10 lg:py-32">
        <SectionLabel label="Testimonials" title="What they say after." />
        <div
          class:list={[
            'mt-12 grid gap-6',
            testimonials.length === 1 ? 'max-w-2xl' : testimonials.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3',
          ]}
        >
          {testimonials.map((t) => (
            <figure data-reveal class="rounded-lg border border-hairline bg-surface p-7">
              <blockquote class="text-lg text-ink">“{t.quote}”</blockquote>
              <figcaption class="mt-5 flex items-center gap-3">
                {t.avatar ? (
                  <img src={t.avatar} alt={t.name} width="40" height="40" loading="lazy" class="h-10 w-10 rounded-full object-cover" />
                ) : (
                  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-hairline font-mono text-sm text-ink">
                    {t.name.charAt(0)}
                  </span>
                )}
                <span class="mono-label">
                  {t.name}
                  {t.role && <>, {t.role}</>}
                  {t.company && <> · {t.company}</>}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <!-- ─────────────── FREE AUDIT ─────────────── -->
  <section id="free-audit" class="border-t border-hairline bg-surface">
    <div class="mx-auto grid max-w-[1400px] gap-12 px-5 py-24 lg:grid-cols-2 lg:px-10 lg:py-32">
      <div data-reveal>
        <p class="mono-label">// Free audit</p>
        <h2 class="mt-4 font-display text-[clamp(2rem,5vw,3.5rem)] font-light leading-[0.98] tracking-normal text-ink">
          Not ready to talk? Get the free audit.
        </h2>
        <p class="mt-5 max-w-md text-lg text-grey">
          We’ll show you the three things hurting your bookings or footfall right now. No call required.
        </p>
      </div>
      <div data-reveal data-reveal-delay="0.15">
        <AuditForm />
      </div>
    </div>
  </section>

  <!-- ─────────────── FINAL CTA ─────────────── -->
  <section class="mx-auto max-w-[1400px] px-5 py-28 lg:px-10 lg:py-36">
    <div data-reveal>
      <p class="mono-label">// Limited intake</p>
      <h2 class="mt-5 max-w-4xl font-display text-[clamp(2.5rem,7vw,6rem)] font-light leading-[0.95] tracking-normal text-ink">
        We take three new clients a quarter. Make it count.
      </h2>
      <a href="/contact" class="btn mt-10">Book a Strategy Call</a>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>

<script>
  // Hero email capture → /api/audit (lead magnet)
  const form = document.querySelector('form[data-hero-form]') as HTMLFormElement | null;
  const msg = document.querySelector('[data-hero-msg]') as HTMLElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msg) return;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    msg.textContent = 'Sending…';
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('/api/audit', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ...data, segment: 'other' }),
      });
      const out = await res.json();
      if (out.ok) {
        form.reset();
        msg.textContent = '✓ Got it — we’ll be in touch within 48 hours.';
      } else {
        msg.textContent = out.error || 'Something went wrong.';
      }
    } catch {
      msg.textContent = 'Network error — please try again.';
    } finally {
      btn.disabled = false;
    }
  });
</script>
