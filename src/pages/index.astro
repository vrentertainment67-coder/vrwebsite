---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import ClientMarquee from '@/components/ClientMarquee.astro';
import Stats from '@/components/Stats.astro';
import Capabilities from '@/components/Capabilities.astro';
import WorkShowcase from '@/components/WorkShowcase.astro';
import Modules from '@/components/Modules.astro';
import Process from '@/components/Process.astro';
import ScoreCTA from '@/components/ScoreCTA.astro';
import Footer from '@/components/Footer.astro';

const title = 'Intelligent websites for venues, hospitality & artists | VR Entertainment';
const description =
  'An intelligent website studio in Bengaluru. We build sites that answer guests, take bookings, rank in AI search and report back every week. 19 years in the night economy.';
---

<Layout title={title} description={description} path="/">
  <Header variant="home" />
  <main id="main">
    <Hero />
    <ClientMarquee />
    <Stats />
    <Capabilities />
    <WorkShowcase />
    <Modules />
    <Process />
    <ScoreCTA />
  </main>
  <Footer variant="home" />

  <script>
    import '@/scripts/home.ts';
  </script>
</Layout>
