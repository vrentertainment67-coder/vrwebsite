---
import Layout from '@/layouts/Layout.astro';
import Marquee from '@/components/Marquee.astro';
import SegmentCard from '@/components/SegmentCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import BeforeAfterSlider from '@/components/BeforeAfterSlider.astro';
import AuditForm from '@/components/AuditForm.astro';
import { SEGMENTS, SERVICES, PROCESS, SITE } from '@/lib/site';

const heroWords = 'WE BUILD THE BRANDS THAT OWN THE NIGHT.'.split(' ');

// Homepage JSON-LD: the org/person/localbusiness come from JsonLd.astro globally.
// Add a PodcastSeries node for The Vic Fix and a Service summary.
const schema = [
  {
    '@type': 'PodcastSeries',
    name: 'The Vic Fix',
    url: `${SITE.url}/the-vic-fix`,
    description: 'India’s nightlife, on the record — a documentary platform on the people who run the night.',
  },
  {
    '@type': 'Service',
    serviceType: 'Nightlife & hospitality growth marketing',
    provider: { '@id': `${SITE.url}/#organization` },
    areaServed: 'IN',
  },
];

// TODO(metrics): case-study numbers below are being verified before publish.
const cases = [
  {
    title: 'djvicofficial.com',
    metric: 'SEO score 38 → 92.',
    body: 'Built on Astro. Ranking and booking.',
    href: '/work/djvicofficial',
  },
  {
    title: 'Flingit',
    metric: 'Built, shipped, run end-to-end.',
    body: 'A full nightlife rewards platform.',
    href: '/work/flingit',
  },
  {
    title: 'The Vic Fix',
    metric: '68% episode-view growth.',
    body: 'Season 1 → Season 2.',
    href: '/work/the-vic-fix',
  },
];
---

<Layout
  title="VR Entertainment — We build the brands that own the night"
  description="Websites, content and growth systems for venues, artists and hospitality brands — built by people who actually live in the nightlife industry."
  path="/"
  schema={schema}
>
  <!-- ─────────────── 1. HERO ─────────────── -->
  <section class="grain relative flex min-h-[100svh] items-center overflow-hidden">
    <!-- Full-bleed media (TODO: drop a real club/festival loop at /hero.mp4 + /hero-poster.jpg) -->
    <div data-hero-media class="absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-gradient-to-br from-[#0a0a0a] via-[#120a0a] to-[#000]"></div>
      <video
        class="h-full w-full object-cover opacity-50"
        autoplay
        muted
        loop
        playsinline
        poster="/hero-poster.jpg"
        aria-hidden="true"
      >
        <source src="/hero.mp4" type="video/mp4" />
      </video>
      <!-- dark grade overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-near-black via-near-black/60 to-near-black/30"></div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-7xl px-5 pt-28 lg:px-8">
      <p class="eyebrow mb-5">Growth agency for the night economy</p>
      <h1
        data-words
        class="max-w-4xl font-display text-[clamp(3rem,9vw,8rem)] leading-[0.92] text-off-white"
        style="perspective: 800px;"
      >
        {heroWords.map((w) => <span class="word mr-[0.25em] inline-block">{w}</span>)}
      </h1>
      <p class="mt-7 max-w-2xl text-lg text-warm-grey md:text-xl" data-reveal data-reveal-delay="0.6">
        Websites, content and growth systems for venues, artists and hospitality brands — built by
        people who actually live in the industry.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4" data-reveal data-reveal-delay="0.8">
        <a href="/contact" class="btn-cta">Book a Strategy Call</a>
        <a href="/work" class="btn-ghost">See the Work</a>
      </div>
    </div>

    <a href="#problem" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-warm-grey/70 hover:text-gold" aria-label="Scroll down">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
    </a>
  </section>

  <!-- credential marquee -->
  <Marquee items={['Universal Music', 'Flingit', '18 Countries', 'Featured on The Vic Fix', '19 Years On The Decks', '₹1L/mo Retainer']} />

  <!-- ─────────────── 2. THE PROBLEM ─────────────── -->
  <section id="problem" class="relative mx-auto max-w-7xl px-5 py-24 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow mb-5">The problem</p>
        <h2 class="font-display text-[clamp(2.2rem,5vw,4rem)] leading-[0.95] text-off-white">
          Most agencies have never set foot in a green room.
        </h2>
        <p class="mt-6 max-w-xl text-lg text-warm-grey">
          They’ll sell you a website that looks like every other website and content that sounds
          like a brochure. Nightlife doesn’t move like that. We know — because we’re in the booth,
          in the studio, and on the floor every week.
        </p>
      </div>
      <!-- Split visual: sterile vs real (TODO: real nightlife footage/stills) -->
      <div class="grid grid-cols-2 gap-3" data-reveal data-reveal-delay="0.2">
        <div class="flex aspect-[3/4] items-end rounded-md bg-gradient-to-b from-[#1a1a1a] to-[#0d0d0d] p-4">
          <span class="text-xs uppercase tracking-widest text-warm-grey/60">Stock. Sterile.</span>
        </div>
        <div class="flex aspect-[3/4] items-end rounded-md bg-gradient-to-b from-[#2a0d0d] to-[#120505] p-4 ring-1 ring-signal-red/30">
          <span class="text-xs uppercase tracking-widest text-off-white">Real nightlife.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────── 3. WHO WE HELP ─────────────── -->
  <section class="bg-deep-black py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mb-12 max-w-2xl" data-reveal>
        <p class="eyebrow mb-5">Who we help</p>
        <h2 class="font-display text-[clamp(2.2rem,5vw,4rem)] text-off-white">Who we build for.</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {SEGMENTS.map((s) => <SegmentCard title={s.title} pitch={s.pitch} href={`/who-we-help/${s.slug}`} />)}
      </div>
    </div>
  </section>

  <!-- ─────────────── 4. THE ARSENAL (SERVICES) ─────────────── -->
  <section class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
    <div class="mb-12 max-w-2xl" data-reveal>
      <p class="eyebrow mb-5">The arsenal</p>
      <h2 class="font-display text-[clamp(2.2rem,5vw,4rem)] text-off-white">
        Everything you need to grow. Nothing you don’t.
      </h2>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {SERVICES.map((s) => <ServiceCard title={s.title} blurb={s.blurb} href={`/services/${s.slug}`} />)}
    </div>
    <div class="mt-10" data-reveal>
      <a href="/services" class="btn-ghost">Explore Services</a>
    </div>
  </section>

  <!-- ─────────────── 5. PROOF (CASE STUDIES) ─────────────── -->
  <section class="bg-deep-black py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mb-12 max-w-2xl" data-reveal>
        <p class="eyebrow mb-5">Proof</p>
        <h2 class="font-display text-[clamp(2.2rem,5vw,4rem)] text-off-white">Receipts.</h2>
      </div>

      <!-- Featured before/after slider (highest-converting interaction) -->
      <div class="mb-10 grid items-center gap-8 lg:grid-cols-2" data-reveal>
        <BeforeAfterSlider
          beforeLabel="Old site · SEO 38"
          afterLabel="New build · SEO 92"
          alt="djvicofficial.com redesign before and after"
        />
        <div>
          <h3 class="font-display text-3xl text-off-white">djvicofficial.com</h3>
          <p class="mt-3 text-lg text-warm-grey">
            {/* TODO(metrics): verify 38 → 92 before publish */}
            SEO score 38 → 92. Built on Astro. Ranking and booking.
          </p>
          <a href="/work/djvicofficial" class="mt-4 inline-block text-gold hover:text-gold-light">Read the case study →</a>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {
          cases.map((c) => (
            <a href={c.href} data-reveal class="glow-gold rounded-md border border-white/10 bg-white/[0.02] p-6">
              <h3 class="font-display text-2xl text-off-white">{c.title}</h3>
              <p class="mt-3 font-display text-3xl text-gold">{c.metric}</p>
              <p class="mt-2 text-sm text-warm-grey">{c.body}</p>
            </a>
          ))
        }
      </div>
      <div class="mt-10" data-reveal>
        <a href="/work" class="btn-ghost">See all work</a>
      </div>
    </div>
  </section>

  <!-- ─────────────── 6. THE UNFAIR ADVANTAGE ─────────────── -->
  <section class="grain relative overflow-hidden py-28">
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-[#120a04] via-near-black to-[#0a0604]"></div>
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-[0.85fr_1fr] lg:px-8">
      <!-- DJ Vic portrait (real) -->
      <div class="relative mx-auto max-w-sm lg:mx-0" data-reveal>
        <div class="absolute -inset-3 -z-10 rounded-md bg-gold/10 blur-2xl"></div>
        <img
          src="/brand/dj-vic.jpg"
          alt="DJ Vic — Vikas Naik, founder of VR Entertainment"
          width="700"
          height="394"
          loading="lazy"
          decoding="async"
          class="w-full rounded-md border border-white/10 object-cover"
        />
      </div>
      <div data-reveal data-reveal-delay="0.15">
        <p class="eyebrow mb-6">The unfair advantage</p>
        <h2 class="font-display text-[clamp(2.2rem,5.5vw,4.5rem)] leading-[0.95] text-off-white">
          We don’t just market the nightlife industry. We’re part of it.
        </h2>
        <p class="mt-7 max-w-2xl text-lg text-warm-grey">
          19 years behind the decks. 18 countries. A Universal Music partnership. A podcast that the
          industry actually watches. When we build your brand, we build it from the inside.
        </p>
      </div>
    </div>
  </section>

  <!-- ─────────────── 7. THE VIC FIX FEATURE ─────────────── -->
  <section class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="order-2 lg:order-1" data-reveal>
        <p class="eyebrow mb-5">Our platform</p>
        <h2 class="font-display text-[clamp(2.2rem,5vw,4rem)] leading-[0.95] text-off-white">
          The Vic Fix — India’s nightlife, on the record.
        </h2>
        <p class="mt-6 max-w-xl text-lg text-warm-grey">
          Our own documentary platform on the people who run the night. It’s how we prove what we
          can build for you.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/the-vic-fix" class="btn-cta">Watch</a>
          <a href="/contact" class="btn-ghost">Partner with the show</a>
        </div>
      </div>
      <!-- Vic Fix logo + teaser (TODO: swap to an embedded reel/teaser when ready) -->
      <div class="order-1 lg:order-2" data-reveal data-reveal-delay="0.2">
        <div class="relative flex aspect-video items-center justify-center overflow-hidden rounded-md border border-white/10 bg-gradient-to-br from-[#1a0a0a] to-[#0a0a0a]">
          <img
            src="/brand/the-vic-fix-logo.png"
            alt="The Vic Fix"
            width="320"
            height="180"
            loading="lazy"
            decoding="async"
            class="max-h-[55%] w-auto object-contain opacity-90"
          />
          <span class="absolute bottom-3 left-3 text-xs uppercase tracking-widest text-warm-grey">The Vic Fix · Teaser</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────── 8. PROCESS ─────────────── -->
  <section class="bg-deep-black py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-6 md:grid-cols-4">
        {
          PROCESS.map((step, i) => (
            <div data-reveal data-reveal-delay={`${i * 0.1}`} class="flex items-baseline gap-4">
              <span class="font-display text-5xl text-gold/40">0{i + 1}</span>
              <div>
                <h3 class="font-display text-3xl text-off-white">{step}</h3>
                {i < PROCESS.length - 1 && <span class="text-warm-grey">→</span>}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─────────────── 9. TESTIMONIALS ─────────────── -->
  <section class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
    <div class="mb-12 max-w-2xl" data-reveal>
      <p class="eyebrow mb-5">Testimonials</p>
      <h2 class="font-display text-[clamp(2.2rem,5vw,4rem)] text-off-white">What they say after.</h2>
    </div>
    <!-- TODO(testimonials): replace placeholders with real quotes from the `testimonials` table -->
    <div class="grid gap-5 md:grid-cols-3">
      {
        [1, 2, 3].map((n) => (
          <figure data-reveal class="rounded-md border border-white/10 bg-white/[0.02] p-7">
            <blockquote class="pull-quote text-xl text-off-white">
              “Placeholder quote — real client testimonial pending.”
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-3">
              <span class="h-10 w-10 rounded-full bg-gradient-to-br from-gold/40 to-warm-grey/20"></span>
              <span class="text-sm text-warm-grey">Name, Role · Company <span class="text-warm-grey/50">(TODO)</span></span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- ─────────────── 10. LEAD MAGNET (FREE AUDIT) ─────────────── -->
  <section id="free-audit" class="grain relative overflow-hidden py-24">
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-deep-black to-near-black"></div>
    <div class="mx-auto max-w-3xl px-5 text-center lg:px-8">
      <div data-reveal>
        <p class="eyebrow mx-auto mb-5 w-fit">Free audit</p>
        <h2 class="font-display text-[clamp(2.2rem,5vw,4rem)] text-off-white">
          Not ready to talk? Get the free audit.
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-lg text-warm-grey">
          We’ll show you the three things hurting your bookings or footfall right now. No call required.
        </p>
      </div>
      <div class="mt-10" data-reveal data-reveal-delay="0.15">
        <AuditForm />
      </div>
    </div>
  </section>

  <!-- ─────────────── 11. FINAL CTA (SCARCITY) ─────────────── -->
  <section class="bg-deep-black py-28">
    <div class="mx-auto max-w-4xl px-5 text-center lg:px-8" data-reveal>
      <h2 class="font-display text-[clamp(2.4rem,6vw,5rem)] leading-[0.95] text-off-white">
        We take three new clients a quarter. Make it count.
      </h2>
      <div class="mt-9">
        <a href="/contact" class="btn-cta text-xl">Book a Strategy Call</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
