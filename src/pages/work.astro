---
import Layout from '../layouts/Layout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
---
<Layout title="Selected Work | VR Entertainment" description="A curated selection of VR Entertainment case studies, outcomes and project highlights across artist management, content production and digital marketing.">
  <section class="bg-background px-6 py-[100px] lg:px-8">
    <div class="mx-auto max-w-[840px] text-center">
      <h1 class="font-display text-[52px] leading-tight text-text-primary">Selected Work</h1>
      <p class="mt-6 text-[18px] leading-[1.8] text-text-secondary font-[300]">A small selection of projects and outcomes.</p>
      <p class="mt-3 text-[14px] text-text-tertiary font-[300]">Client details shared on request. Some projects anonymised by agreement.</p>
    </div>
  </section>

  <section class="bg-surface px-6 py-[100px] lg:px-8">
    <div class="mx-auto grid max-w-[1200px] gap-10">
      <CaseStudyCard
        category="ARTIST MANAGEMENT"
        descriptor="Independent Electronic Music Artist, Bangalore"
        challenge="Strong live following but no digital infrastructure or label strategy. Streaming numbers were stagnant despite active gigging."
        actions={['Built a 12-month career roadmap', 'Redesigned digital brand identity', 'Coordinated content strategy aligned to release schedule', 'Facilitated introductions to two independent labels']}
        outcome="3× DSP streaming growth. Label conversations initiated within 8 months."
        status="Ongoing"
      />
      <CaseStudyCard
        category="CONTENT & PRODUCTION"
        descriptor="Boutique Hospitality Brand, South India"
        challenge="Wanted to build an Instagram presence with cultural relevance but had no internal production capacity."
        actions={['Developed monthly content series concept', 'Handled full production and post-production', 'Managed publishing and community responses', 'Built a 6-month content calendar']}
        outcome="120K organic impressions on launch series. Follower growth of 340% in 4 months."
        status="Completed"
      />
      <CaseStudyCard
        category="DIGITAL MARKETING"
        descriptor="Independent Hip-Hop Artist, Mumbai"
        challenge="Preparing for first EP release with no existing digital marketing strategy or paid media experience."
        actions={['Built pre-release content campaign', 'Managed paid social across Meta and YouTube', 'Coordinated with DSPs for playlist consideration', 'Handled release week social management']}
        outcome="First release hit 50K streams in 30 days. Featured on two Spotify editorial playlists."
        status="Completed"
      />
    </div>
  </section>

  <section class="bg-background px-6 py-[100px] lg:px-8">
    <div class="mx-auto max-w-[840px] text-center">
      <h2 class="font-display text-[40px] leading-tight text-text-primary">Working on something? Let's talk.</h2>
      <a href="/contact" class="mt-8 inline-flex rounded-[8px] border border-accent px-8 py-4 text-[14px] font-[500] text-accent hover:bg-accent hover:text-background transition duration-300 ease-in-out">Inquire</a>
    </div>
  </section>
</Layout>
