---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import BeforeAfterSlider from '@/components/BeforeAfterSlider.astro';
import BrowserFrame from '@/components/BrowserFrame.astro';
import { CASE_STUDIES } from '@/lib/work';

export function getStaticPaths() {
  return CASE_STUDIES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const frameUrl = c.slug === 'djvicofficial' ? 'djvicofficial.com' : c.slug === 'flingit' ? 'flingit.in' : `${c.slug}.com`;
---

<Layout title={`${c.title} — Work — VR Entertainment`} description={c.summary} path={`/work/${c.slug}`}>
  <PageHero eyebrow={`${c.client} · YR/ 2026`} title={c.title} subtitle={c.summary} />

  <section class="mx-auto max-w-5xl px-5 py-16 lg:px-10">
    {c.hasSlider && (
      <div class="mb-12" data-reveal>
        <BrowserFrame url={frameUrl}>
          <BeforeAfterSlider
            beforeLabel={`Before · ${c.metricLabel} ${c.metricBefore}`}
            afterLabel={`After · ${c.metricLabel} ${c.metricAfter}`}
            alt={`${c.title} before and after`}
          />
        </BrowserFrame>
      </div>
    )}

    <!-- Metric callout — TODO(metrics): verify before publish -->
    <div class="mb-12 flex flex-wrap items-end gap-8 rounded-lg border border-hairline bg-surface p-7" data-reveal>
      <div>
        <p class="mono-label">{c.metricLabel}</p>
        <p class="font-display text-2xl font-extrabold tracking-tight text-grey">{c.metricBefore}</p>
      </div>
      <span class="font-display text-3xl font-extrabold text-accent">→</span>
      <div>
        <p class="mono-label">After</p>
        <p class="font-display text-5xl font-extrabold tracking-tight text-accent">{c.metricAfter}</p>
      </div>
    </div>

    <div class="grid gap-10 md:grid-cols-3" data-reveal>
      <div>
        <p class="mono-label mb-2">// The problem</p>
        <p class="text-grey">{c.problem}</p>
      </div>
      <div>
        <p class="mono-label mb-2">// The approach</p>
        <p class="text-grey">{c.approach}</p>
      </div>
      <div>
        <p class="mono-label mb-2">// The result</p>
        <p class="text-grey">{c.result}</p>
      </div>
    </div>

    <div class="mt-14" data-reveal>
      <a href="/contact" class="btn">Book a Strategy Call</a>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
