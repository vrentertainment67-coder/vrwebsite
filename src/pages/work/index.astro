---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import { CASE_STUDIES } from '@/lib/work';
---

<Layout
  title="Work — VR Entertainment"
  description="Receipts. Case studies from the venues, artists and brands we’ve built for."
  path="/work"
>
  <PageHero eyebrow="Proof" title="Receipts." subtitle="The brands we’ve built, and what changed after." />

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div class="grid gap-5 md:grid-cols-3">
      {
        CASE_STUDIES.map((c) => (
          <a href={`/work/${c.slug}`} data-reveal class="glow-gold flex flex-col rounded-md border border-white/10 bg-white/[0.02] p-7">
            <span class="text-xs uppercase tracking-widest text-warm-grey">{c.client}</span>
            <h2 class="mt-2 font-display text-3xl text-off-white">{c.title}</h2>
            <p class="mt-3 text-sm text-warm-grey">{c.summary}</p>
            <div class="mt-5 flex items-baseline gap-2">
              <span class="font-display text-4xl text-gold">{c.metricAfter}</span>
              <span class="text-xs text-warm-grey">{c.metricLabel}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
