---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import WorkCard from '@/components/WorkCard.astro';
import { CASE_STUDIES } from '@/lib/work';

const workTags: Record<string, string[]> = {
  djvicofficial: ['Web Design', 'SEO', 'Astro'],
  flingit: ['Product', 'Platform', 'Build'],
  'the-vic-fix': ['Video', 'Distribution', 'Growth'],
};
---

<Layout
  title="Work — VR Entertainment"
  description="Receipts. Case studies from the venues, artists and brands we’ve built for."
  path="/work"
>
  <PageHero index="03" eyebrow="Proof" title="Receipts." subtitle="The brands we’ve built, and what changed after." />

  <section class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10 lg:py-28">
    <div class="grid gap-x-8 gap-y-12 md:grid-cols-3">
      {CASE_STUDIES.map((c) => (
        <WorkCard
          href={`/work/${c.slug}`}
          client={c.client}
          title={c.title}
          descriptor={c.summary}
          metricLabel={c.metricLabel}
          metricAfter={c.metricAfter}
          tags={workTags[c.slug] ?? []}
          year="2026"
        />
      ))}
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
