---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
---
<Layout title="Artist Management | VR Entertainment" description="VR Entertainment develops independent artists with career strategy, brand direction, label introductions, booking support and digital presence management.">
  <section class="bg-background px-6 py-[100px] lg:px-8">
    <div class="mx-auto grid max-w-[1200px] gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-terracotta font-[300]">ARTIST MANAGEMENT</p>
        <h1 class="mt-6 font-display text-[52px] leading-tight text-text-primary">We develop independent artists.</h1>
        <p class="mt-6 text-[18px] leading-[1.8] text-text-secondary font-[300]">From your first 1,000 listeners to your first label deal — we build the career infrastructure around your talent.</p>
      </div>
      <div class="rounded-[6px] border border-border bg-surface p-10">
        <p class="text-[14px] uppercase tracking-[0.18em] text-text-tertiary">Our artist approach</p>
        <p class="mt-6 text-[16px] leading-[1.8] text-text-primary font-[300]">We build career support that is tailored, selective, and driven by clear audience outcomes.</p>
      </div>
    </div>
  </section>

  <section class="bg-surface px-6 py-[100px] lg:px-8">
    <div class="mx-auto grid max-w-[1200px] gap-12 lg:grid-cols-2">
      <div class="space-y-10">
        <div>
          <h2 class="text-[28px] font-display text-text-primary">What's included</h2>
          <div class="mt-8 space-y-4 text-[16px] leading-8 text-text-secondary font-[300]">
            <p>Career strategy and roadmap</p>
            <p>Brand identity development</p>
            <p>Content direction and oversight</p>
            <p>Label and industry introductions</p>
            <p>Booking coordination</p>
            <p>Press and PR strategy</p>
            <p>Digital presence management</p>
          </div>
        </div>
      </div>
      <div class="rounded-[6px] border border-border bg-background p-10">
        <h2 class="text-[28px] font-display text-text-primary">Who this is for</h2>
        <div class="mt-8 space-y-4 text-[16px] leading-8 text-text-secondary font-[300]">
          <p>Independent artists with existing traction (any genre)</p>
          <p>Artists preparing for label conversations</p>
          <p>Creators transitioning into the music space</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background px-6 py-[100px] lg:px-8">
    <div class="mx-auto max-w-[840px] rounded-[6px] border border-border bg-surface p-10">
      <h2 class="text-[28px] font-display text-text-primary">How we take on artists</h2>
      <div class="mt-8 space-y-5 text-[16px] leading-8 text-text-secondary font-[300]">
        <p>We work with a maximum of 3 artists at a time.</p>
        <p>All new artists go through an application process.</p>
        <p>We only work with artists we genuinely believe in.</p>
      </div>
    </div>
  </section>

  <section class="bg-surface px-6 py-[100px] lg:px-8">
    <div class="mx-auto max-w-[840px] text-center">
      <h2 class="font-display text-[40px] leading-tight text-text-primary">Apply to work with us</h2>
      <p class="mt-6 text-[16px] leading-[1.8] text-text-secondary font-[300]">We're selective because we have to be. If we take on your project, we're fully committed.</p>
      <a href="/contact?type=artist" class="mt-8 inline-flex rounded-[8px] border border-accent px-8 py-4 text-[14px] font-[500] text-accent hover:bg-accent hover:text-background transition duration-300 ease-in-out">Submit an Application →</a>
    </div>
  </section>
</Layout>
