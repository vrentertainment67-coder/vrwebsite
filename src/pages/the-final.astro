---
import Layout from '@/layouts/Layout.astro';
import { event } from '@/data/the-final';
import { SITE } from '@/lib/site';
// Event-only fonts (DJ VIC deck identity), scoped to this page's bundle.
import '@fontsource/bebas-neue/400.css';
import '@fontsource/playfair-display/400-italic.css';

const money = (n: number) => '₹' + n.toLocaleString('en-IN');

const ogImage = '/og-the-final.jpg'; // 1200×630 — no FIFA marks
const desc =
  'Watch the World Cup Final on the big screen at Lolas, Bangalore. DJ Andre + DJ Vic live, premium food & drinks, the halftime show. Pre-register for early-bird passes.';

const detailLine = `${event.venue.name}, ${event.venue.city}  ·  ${event.when.dateLabel}  ·  Doors ${event.when.doors}  ·  Kickoff ${event.when.kickoff}`;

// Event JSON-LD — plain-text naming only, no official marks.
const schema = [
  {
    '@type': 'Event',
    name: event.name,
    description: desc,
    startDate: event.when.kickoffISO,
    endDate: '2026-07-20T03:30:00+05:30',
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    image: [new URL(ogImage, SITE.url).toString()],
    location: {
      '@type': 'Place',
      name: event.venue.fullName,
      telephone: event.venue.phone,
      address: {
        '@type': 'PostalAddress',
        streetAddress: event.venue.streetAddress,
        addressLocality: event.venue.addressLocality,
        addressRegion: event.venue.addressRegion,
        postalCode: event.venue.postalCode,
        addressCountry: 'IN',
      },
    },
    performer: [
      { '@type': 'PerformingGroup', name: 'DJ Andre' },
      { '@type': 'Person', name: 'DJ Vic' },
    ],
    organizer: { '@id': `${SITE.url}/#organization` },
    offers: event.passes.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      price: p.price,
      priceCurrency: 'INR',
      availability: 'https://schema.org/InStock',
      url: `${SITE.url}/the-final`,
    })),
  },
];

// Simple inline icon set for the feature list
const icons: Record<string, string> = {
  screen: 'M2 4h20v12H2z M8 20h8 M12 16v4',
  decks: 'M5 12a7 7 0 0 1 14 0 M12 12v6 M8 18h8',
  star: 'M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.3l6.1-.7z',
  food: 'M4 3v8a3 3 0 0 0 6 0V3 M7 11v10 M17 3c-1.7 1.5-2 4-2 6s.6 3 2 3 2-1 2-3-.3-4.5-2-6z M17 12v9',
  trophy: 'M7 4h10v5a5 5 0 0 1-10 0z M7 6H4v2a3 3 0 0 0 3 3 M17 6h3v2a3 3 0 0 1-3 3 M10 14h4 M9 20h6 M12 14v6',
};
---

<Layout
  title="The Final — World Cup Final Screening at Lolas, Bangalore · 20 July"
  description={desc}
  path="/the-final"
  image={ogImage}
  schema={schema}
  bare={true}
>
  <div class="ev relative min-h-screen overflow-hidden bg-[#0A0A0A] text-[#E8E8E0] pb-24 md:pb-0">
    <!-- ─────────── HERO ─────────── -->
    <section class="relative overflow-hidden">
      <div class="hero-glow"></div>
      <div class="grain"></div>
      <div class="relative mx-auto max-w-4xl px-6 pt-14 pb-14 text-center">
        <p class="reveal ev-display text-sm md:text-base tracking-[0.3em] text-[#C9A84C]">{event.kicker}</p>

        <h1 class="reveal ev-display text-7xl md:text-9xl leading-[0.9] mt-4 text-[#E8E8E0]">THE FINAL</h1>

        <p class="reveal ev-italic text-2xl md:text-3xl text-[#C9A84C] mt-3">{event.subtitle}</p>

        <p class="reveal text-[#8A8878] mt-5 text-sm md:text-base">{detailLine}</p>

        <!-- COUNTDOWN -->
        <div class="reveal mt-8 flex items-center justify-center gap-3 md:gap-5" data-kickoff={event.when.kickoffISO} aria-label="Countdown to kickoff">
          {['Days', 'Hrs', 'Min', 'Sec'].map((u) => (
            <div class="min-w-[64px] rounded-xl border border-[#2A2A22] bg-[#18160F]/80 px-3 py-2">
              <div class="ev-display text-4xl md:text-5xl leading-none text-[#C9A84C]" data-unit={u.toLowerCase()}>--</div>
              <div class="text-[0.6rem] tracking-[0.2em] text-[#8A8878] mt-1">{u.toUpperCase()}</div>
            </div>
          ))}
        </div>
        <p class="reveal text-[#8A8878] text-xs mt-3">until kickoff</p>

        <div class="reveal mt-9">
          <a href="#register" class="cta-red inline-flex items-center justify-center bg-[#FF3B3B] text-white ev-display text-2xl md:text-3xl tracking-wide px-10 py-4 rounded-xl">
            Pre-register now
          </a>
        </div>

        {event.sponsor.showCredit && (
          <p class="reveal mt-6 text-[#8A8878] text-xs tracking-[0.15em] uppercase">{event.sponsor.creditLine}</p>
        )}
      </div>
    </section>

    <!-- ─────────── THE NIGHT ─────────── -->
    <section class="relative mx-auto max-w-4xl px-6 py-14">
      <h2 class="reveal ev-display text-5xl md:text-6xl text-[#E8E8E0]">The night</h2>
      <p class="reveal text-[#8A8878] mt-4 text-base md:text-lg leading-relaxed">{event.theNight.body}</p>

      <ul class="mt-8 grid sm:grid-cols-2 gap-3">
        {event.theNight.features.map((f) => (
          <li class="reveal flex items-start gap-3 rounded-xl border border-[#2A2A22] bg-[#18160F] p-4">
            <svg class="mt-0.5 shrink-0" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[f.icon]} />
            </svg>
            <span class="text-[#E8E8E0]">{f.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ─────────── PASSES ─────────── -->
    <section class="relative mx-auto max-w-4xl px-6 py-14">
      <h2 class="reveal ev-display text-5xl md:text-6xl text-[#E8E8E0]">Passes</h2>
      <div class="mt-8 grid sm:grid-cols-2 gap-4">
        {event.passes.map((p) => (
          <div class:list={[
            'reveal relative flex flex-col rounded-2xl p-7 bg-[#18160F] border',
            p.featured ? 'pkg-featured border-[#C9A84C]' : 'border-[#2A2A22]',
          ]}>
            {p.featured && (
              <span class="absolute -top-3 left-7 bg-[#C9A84C] text-[#0A0A0A] text-[0.6rem] font-bold tracking-[0.15em] uppercase px-3 py-1 rounded-full">Best value</span>
            )}
            <p class="ev-display text-3xl text-[#C9A84C]">{p.name}</p>
            <p class="ev-display text-5xl mt-1 text-[#E8E8E0]">{money(p.price)}</p>
            <p class="text-[#8A8878] text-sm mt-1">{p.note}</p>
          </div>
        ))}
      </div>
      <p class="reveal text-[#8A8878] text-sm mt-5">{event.passesNote}</p>
      <div class="reveal mt-6">
        <a href="#register" class="cta-red inline-flex items-center justify-center bg-[#FF3B3B] text-white ev-display text-2xl tracking-wide px-8 py-4 rounded-xl">Pre-register now</a>
      </div>
    </section>

    <!-- ─────────── REGISTER ─────────── -->
    <section id="register" class="relative mx-auto max-w-2xl px-6 py-14">
      <div class="rounded-2xl border border-[#2A2A22] bg-[#18160F] p-7 md:p-9">
        <h2 class="ev-display text-5xl text-[#E8E8E0]">Pre-register</h2>
        <p class="text-[#8A8878] mt-2 mb-6">Lock your spot — we’ll WhatsApp you your pass details.</p>

        <form id="reg-form" class="grid gap-3" novalidate>
          <div>
            <label for="reg-name" class="sr-only">Full name</label>
            <input id="reg-name" name="name" required placeholder="Full name" autocomplete="name"
              class="w-full bg-[#141414] border border-[#2A2A22] rounded-lg px-4 py-3 text-[#E8E8E0] placeholder:text-[#8A8878] focus:border-[#C9A84C] focus:outline-none" />
          </div>
          <div>
            <label for="reg-wa" class="sr-only">WhatsApp number</label>
            <input id="reg-wa" name="whatsapp" required inputmode="tel" autocomplete="tel" placeholder="WhatsApp number"
              class="w-full bg-[#141414] border border-[#2A2A22] rounded-lg px-4 py-3 text-[#E8E8E0] placeholder:text-[#8A8878] focus:border-[#C9A84C] focus:outline-none" />
          </div>
          <div>
            <label for="reg-email" class="sr-only">Email</label>
            <input id="reg-email" name="email" type="email" autocomplete="email" placeholder="Email"
              class="w-full bg-[#141414] border border-[#2A2A22] rounded-lg px-4 py-3 text-[#E8E8E0] placeholder:text-[#8A8878] focus:border-[#C9A84C] focus:outline-none" />
          </div>
          <div>
            <label for="reg-size" class="sr-only">Number of guests</label>
            <input id="reg-size" name="party_size" type="number" min="1" max="50" value="1" placeholder="Number of guests"
              class="w-full bg-[#141414] border border-[#2A2A22] rounded-lg px-4 py-3 text-[#E8E8E0] focus:border-[#C9A84C] focus:outline-none" />
          </div>
          <!-- honeypot -->
          <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <button type="submit" class="cta-red bg-[#FF3B3B] text-white ev-display text-2xl tracking-wide px-6 py-4 rounded-xl">Pre-register</button>
        </form>
        <p id="reg-msg" class="mt-3 text-sm hidden" role="status" aria-live="polite"></p>
      </div>
    </section>

    <!-- ─────────── KNOW BEFORE YOU GO ─────────── -->
    <section class="relative mx-auto max-w-2xl px-6 py-14">
      <h2 class="reveal ev-display text-4xl text-[#E8E8E0] mb-5">Know before you go</h2>
      <ul class="divide-y divide-[#2A2A22] border-y border-[#2A2A22]">
        <li class="reveal py-3">
          <p class="text-[#E8E8E0] font-semibold">{event.venue.fullName}</p>
          <address class="not-italic text-[#8A8878] text-sm mt-1 leading-relaxed">
            {event.venue.addressLines.map((line) => <span class="block">{line}</span>)}
          </address>
          <p class="mt-2 text-sm">
            <a href={event.venue.mapsUrl} target="_blank" rel="noopener" class="text-[#C9A84C] hover:underline">Directions →</a>
            <span class="text-[#8A8878]"> · </span>
            <a href={`tel:${event.venue.phone.replace(/\s/g, '')}`} class="text-[#C9A84C] hover:underline">{event.venue.phone}</a>
          </p>
        </li>
        <li class="reveal py-3 text-[#E8E8E0]">21+ only · carry a valid photo ID</li>
        <li class="reveal py-3 text-[#E8E8E0]">Late-night event · plan your ride home</li>
        <li class="reveal py-3 text-[#E8E8E0]">Drink responsibly</li>
      </ul>
    </section>

    <!-- ─────────── FOOTER ─────────── -->
    <footer class="border-t border-[#2A2A22] mt-6">
      <div class="mx-auto max-w-4xl px-6 py-8 text-[#8A8878] text-sm">
        <p class="text-[#E8E8E0] font-semibold">An event by VR Entertainment · co-produced by DJ Andre</p>
        <p class="mt-2">
          <a href={event.socials.thevicfix} target="_blank" rel="noopener" class="hover:text-[#C9A84C]">@thevicfix</a>
          · <a href={event.socials.djvic} target="_blank" rel="noopener" class="hover:text-[#C9A84C]">@djvicofficial</a>
          · <a href={`mailto:${event.contacts.bookingsEmail}`} class="hover:text-[#C9A84C]">{event.contacts.bookingsEmail}</a>
        </p>
        {event.sponsor.showCredit && <p class="mt-2">{event.sponsor.creditLine}</p>}
        <p class="mt-3 text-xs">21+ only · Drink responsibly.</p>
      </div>
    </footer>
  </div>

  <!-- Sticky mobile CTA -->
  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-[#2A2A22] bg-[#0A0A0A]/95 px-4 py-3 backdrop-blur md:hidden">
    <a href="#register" class="block w-full text-center bg-[#FF3B3B] text-white ev-display text-xl tracking-wide py-3 rounded-lg">Pre-register now</a>
  </div>
</Layout>

<style>
  .ev-display { font-family: 'Bebas Neue', sans-serif; font-weight: 400; letter-spacing: 0.02em; }
  .ev-italic { font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-weight: 400; }

  .hero-glow {
    position: absolute; inset: -20% 0 auto 0; height: 90%;
    background: radial-gradient(60% 55% at 50% 25%, rgba(201, 168, 76, 0.18), rgba(201, 168, 76, 0.05) 45%, transparent 70%);
    pointer-events: none;
  }
  .grain {
    position: absolute; inset: 0; pointer-events: none; opacity: 0.06; z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }
  .pkg-featured { box-shadow: 0 0 60px -12px rgba(201, 168, 76, 0.35); }
  .cta-red { box-shadow: 0 10px 40px -10px rgba(255, 59, 59, 0.55); transition: transform 0.25s ease, filter 0.25s ease; }
  .cta-red:hover { transform: translateY(-2px); filter: brightness(1.08); }

  .reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1 !important; transform: none !important; transition: none; }
  }
</style>

<script>
  // ── Scroll reveals ──
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealEls = document.querySelectorAll('.reveal');
  if (reduce) {
    revealEls.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
      { threshold: 0.12 }
    );
    revealEls.forEach((el) => io.observe(el));
  }

  // ── Countdown to kickoff ──
  const kickoffEl = document.querySelector('[data-kickoff]');
  const target = new Date(kickoffEl?.getAttribute('data-kickoff') || '2026-07-20T00:30:00+05:30').getTime();
  const units: Record<string, HTMLElement | null> = {
    days: document.querySelector('[data-unit="days"]'),
    hrs: document.querySelector('[data-unit="hrs"]'),
    min: document.querySelector('[data-unit="min"]'),
    sec: document.querySelector('[data-unit="sec"]'),
  };
  const pad = (n: number) => String(n).padStart(2, '0');
  function tickCountdown() {
    const diff = target - Date.now();
    if (diff <= 0) {
      if (units.days) units.days.textContent = '0';
      ['hrs', 'min', 'sec'].forEach((k) => units[k] && (units[k]!.textContent = '00'));
      return;
    }
    if (units.days) units.days.textContent = String(Math.floor(diff / 86400000));
    if (units.hrs) units.hrs.textContent = pad(Math.floor((diff % 86400000) / 3600000));
    if (units.min) units.min.textContent = pad(Math.floor((diff % 3600000) / 60000));
    if (units.sec) units.sec.textContent = pad(Math.floor((diff % 60000) / 1000));
  }
  tickCountdown();
  setInterval(tickCountdown, 1000);

  // ── Register form → /api/prereg ──
  const form = document.getElementById('reg-form') as HTMLFormElement | null;
  const msg = document.getElementById('reg-msg');

  function show(text: string, color: string) {
    if (!msg) return;
    msg.classList.remove('hidden');
    msg.style.color = color;
    msg.textContent = text;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;

    // Client-side validation
    if (!data.name?.trim()) return show('Please add your full name.', '#FF3B3B');
    if ((data.whatsapp || '').replace(/\D/g, '').length < 8) return show('Please add a valid WhatsApp number.', '#FF3B3B');
    if (data.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) return show('That email doesn’t look right.', '#FF3B3B');

    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    const label = btn.textContent;
    btn.textContent = 'Sending…';
    show('Sending…', '#C9A84C');

    try {
      const res = await fetch('/api/prereg', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json();
      if (out.ok) {
        (window as any).umami?.track?.('prereg_submit');
        form.reset();
        show('You’re on the list. We’ll WhatsApp you your pass details and the early-bird link.', '#C9A84C');
      } else {
        show(out.error || 'Something went wrong — please try again.', '#FF3B3B');
      }
    } catch {
      show('Network error — please try again.', '#FF3B3B');
    } finally {
      btn.disabled = false;
      btn.textContent = label;
    }
  });
</script>
