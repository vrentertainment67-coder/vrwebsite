---
import Layout from '@/layouts/Layout.astro';
import { event } from '@/data/the-final';
import { SITE } from '@/lib/site';
// Event-only fonts (deck identity), scoped to this page's bundle.
import '@fontsource/bebas-neue/400.css';
import '@fontsource/playfair-display/400-italic.css';

const money = (n: number | null) => (n == null ? '' : '₹' + n.toLocaleString('en-IN'));

const waMsg = encodeURIComponent(
  "Hi! I'd like to pre-book for The Final at Lolas on 19 July. Package: ____, Guests: ____"
);
const waHref = `https://wa.me/${event.contacts.whatsappPrimary}?text=${waMsg}`;
const waAndre = `https://wa.me/${event.contacts.whatsappSecondary}`;

const ogImage = '/the-final-og.jpg'; // 1200×628 "THE FINAL · LOLAS" banner (no FIFA/team marks)
const desc =
  "Football's biggest final on the big screen at Lolas. Doors 10 PM, kickoff 12:30 AM. Scored live by DJ Andre + DJ Vic. Pre-book now.";

const schema = [
  {
    '@type': 'Event',
    name: event.name,
    description: desc,
    startDate: '2026-07-20T00:30:00+05:30',
    endDate: '2026-07-20T03:30:00+05:30',
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    image: [new URL(ogImage, SITE.url).toString()],
    location: {
      '@type': 'Place',
      name: event.venue.name,
      address: { '@type': 'PostalAddress', addressLocality: event.venue.city, addressCountry: 'IN' },
    },
    performer: [
      { '@type': 'PerformingGroup', name: 'DJ Andre' },
      { '@type': 'Person', name: 'DJ Vic' },
    ],
    organizer: { '@id': `${SITE.url}/#organization` },
    offers: event.packages
      .filter((p) => p.price != null)
      .map((p) => ({
        '@type': 'Offer',
        name: p.name,
        price: p.price,
        priceCurrency: 'INR',
        availability: 'https://schema.org/InStock',
        url: `${SITE.url}/the-final`,
      })),
  },
];

const faqs = [
  { q: 'When & where?', a: `${event.when.dateLabel} at ${event.venue.name}, ${event.venue.city}. Doors ${event.when.doors}, kickoff ${event.when.kickoff}, close ${event.when.closes}.` },
  { q: 'What’s included?', a: 'Entry gets you in the room for the full night (food & drinks à la carte, ₹500 redeemable). The Unlimited Pour adds unlimited premium scotch + mixers all night. VIP is reserved prime-view seating on request.' },
  { q: 'Is it 21+?', a: 'Yes — this is a 21+ event. Please carry a valid ID.' },
  { q: 'Is there food?', a: 'Yes, food is available à la carte through the night.' },
  { q: 'Getting home late?', a: 'We finish at 3:30 AM — please plan a cab. Don’t drink and drive.' },
  { q: 'Is the screening licensed?', a: 'Yes — a licensed screening at the venue on the big screen with full sound.' },
];
---

<Layout
  title="The Final · Live at Lolas, Bengaluru"
  description={desc}
  path="/the-final"
  image={ogImage}
  schema={schema}
  bare={true}
>
  <div class="ev relative min-h-screen overflow-hidden bg-[#0A0A0A] text-[#E8E8E0] pb-24 md:pb-0">
    <!-- ─────────── HERO ─────────── -->
    <section class="relative overflow-hidden">
      <div class="hero-glow"></div>
      <div class="grain"></div>
      <div class="relative mx-auto max-w-4xl px-6 pt-14 pb-16 text-center">
        <p class="reveal text-[#C9A84C] tracking-[0.35em] text-xs font-semibold">SUNDAY NIGHT · LATE · {event.venue.city.toUpperCase()}</p>

        <!-- Banner is the visual headline; keep an SR-only H1 for SEO/a11y -->
        <h1 class="sr-only">The Final — live at {event.venue.name}, {event.venue.city}</h1>
        <img
          src="/the-final-og.jpg"
          alt="The Final — live at Lolas, Bengaluru"
          width="1200"
          height="628"
          fetchpriority="high"
          class="reveal poster mx-auto mt-6 w-full max-w-3xl rounded-2xl"
        />

        <p class="reveal ev-italic text-xl md:text-2xl text-[#C9A84C] mt-6">{event.tagline}</p>
        <p class="reveal text-[#8A8878] mt-2">Kickoff {event.when.kickoff} · Scored live by <span class="text-[#E8E8E0]">DJ Andre + DJ Vic</span></p>

        <!-- COUNTDOWN -->
        <div class="reveal mt-8 flex items-center justify-center gap-3 md:gap-5" data-countdown aria-label="Countdown to kickoff">
          {['Days', 'Hrs', 'Min', 'Sec'].map((u) => (
            <div class="min-w-[64px] rounded-xl border border-[#2A2A22] bg-[#141414]/70 px-3 py-2">
              <div class="ev-display text-4xl md:text-5xl leading-none text-[#C9A84C]" data-unit={u.toLowerCase()}>--</div>
              <div class="text-[0.6rem] tracking-[0.2em] text-[#8A8878] mt-1">{u.toUpperCase()}</div>
            </div>
          ))}
        </div>
        <p class="reveal text-[#8A8878] text-xs mt-3">until kickoff</p>

        <!-- CTAs -->
        <div class="reveal mt-9 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3">
          <a href={waHref} target="_blank" rel="noopener" data-umami-event="whatsapp_click"
             class="cta-red inline-flex items-center justify-center gap-2 bg-[#FF3B3B] text-white ev-display text-2xl tracking-wide px-8 py-4 rounded-xl">
            Reserve on WhatsApp
          </a>
          <a href="#prebook"
             class="inline-flex items-center justify-center gap-2 border border-[#C9A84C]/60 text-[#C9A84C] ev-display text-2xl tracking-wide px-8 py-4 rounded-xl transition-colors hover:bg-[#C9A84C]/10">
            Pre-book your spot
          </a>
        </div>
        <p class="reveal text-[#8A8878] text-xs mt-5">
          {event.when.ageNote.replace('only', '').trim()} · Doors {event.when.doors} · Limited to {event.capacity} ·
          <a href={event.venue.mapsUrl} target="_blank" rel="noopener" class="text-[#C9A84C] hover:underline">Directions →</a>
        </p>
      </div>
    </section>

    <!-- ─────────── RUN OF NIGHT ─────────── -->
    <section class="relative mx-auto max-w-5xl px-6 py-16">
      <p class="reveal text-[#C9A84C] tracking-[0.3em] text-xs font-semibold">THE MATCHDAY</p>
      <h2 class="reveal ev-display text-5xl md:text-6xl text-[#E8E8E0] mt-2 mb-8">Run of night</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {event.runOfNight.map((s, i) => (
          <div class="reveal group relative bg-[#16150F] border border-[#2A2A22] rounded-2xl p-6 transition-colors hover:border-[#C9A84C]/50">
            <div class="w-11 h-11 rounded-full bg-[#C9A84C] text-[#0A0A0A] ev-display text-2xl grid place-items-center shadow-[0_0_24px_rgba(201,168,76,0.35)]">{i + 1}</div>
            <p class="text-[#C9A84C] font-semibold mt-4 tracking-wide">{s.time}</p>
            <p class="text-[#E8E8E0] font-semibold text-lg">{s.title}</p>
            <p class="text-[#8A8878] text-sm mt-2">{s.note}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ─────────── PACKAGES ─────────── -->
    <section class="relative mx-auto max-w-5xl px-6 py-16">
      <p class="reveal text-[#C9A84C] tracking-[0.3em] text-xs font-semibold">CHOOSE YOUR NIGHT</p>
      <h2 class="reveal ev-display text-5xl md:text-6xl mt-2 mb-8 text-[#E8E8E0]">Pick your table</h2>
      <div class="grid md:grid-cols-3 gap-4 md:items-stretch">
        {event.packages.map((p) => (
          <div class:list={[
            'reveal relative flex flex-col rounded-2xl p-7 bg-[#16150F] border transition-transform',
            p.featured ? 'pkg-featured border-[#C9A84C] md:-translate-y-2' : 'border-[#2A2A22]',
          ]}>
            {p.featured && (
              <span class="absolute -top-3 left-7 bg-[#C9A84C] text-[#0A0A0A] text-[0.6rem] font-bold tracking-[0.15em] uppercase px-3 py-1 rounded-full">Most popular</span>
            )}
            <p class="ev-display text-3xl text-[#C9A84C]">{p.name}</p>
            <p class="ev-display text-5xl mt-1 text-[#E8E8E0]">{money(p.price) || 'On request'}</p>
            <p class="text-[#8A8878] text-xs">{p.priceNote}</p>
            <p class="text-sm mt-4 text-[#E8E8E0] flex-1">{p.blurb}</p>
            <button type="button" data-pkg={p.id}
              class:list={[
                'pkg-cta mt-6 inline-flex items-center justify-center gap-1 rounded-lg px-5 py-3 ev-display text-xl tracking-wide transition-colors',
                p.featured ? 'bg-[#FF3B3B] text-white' : 'border border-[#C9A84C]/50 text-[#C9A84C] hover:bg-[#C9A84C]/10',
              ]}>
              Pre-book →
            </button>
          </div>
        ))}
      </div>
    </section>

    <!-- ─────────── PRE-BOOK ─────────── -->
    <section id="prebook" class="relative mx-auto max-w-2xl px-6 py-16">
      <div class="rounded-2xl border border-[#2A2A22] bg-[#16150F] p-7 md:p-9">
        <p class="text-[#C9A84C] tracking-[0.3em] text-xs font-semibold">LOCK IT IN</p>
        <h2 class="ev-display text-5xl mt-2 mb-1 text-[#E8E8E0]">Pre-book your spot</h2>
        <p class="text-[#8A8878] mb-6">Reserve now — we’ll confirm on WhatsApp. Limited to {event.capacity}.</p>

        <form id="prebook-form" class="grid gap-3">
          <input name="name" required placeholder="Name" class="bg-[#141414] border border-[#2A2A22] rounded-lg px-4 py-3 text-[#E8E8E0] placeholder:text-[#8A8878] focus:border-[#C9A84C] focus:outline-none" />
          <input name="whatsapp" required inputmode="tel" placeholder="WhatsApp number" class="bg-[#141414] border border-[#2A2A22] rounded-lg px-4 py-3 text-[#E8E8E0] placeholder:text-[#8A8878] focus:border-[#C9A84C] focus:outline-none" />
          <input name="email" type="email" placeholder="Email (optional)" class="bg-[#141414] border border-[#2A2A22] rounded-lg px-4 py-3 text-[#E8E8E0] placeholder:text-[#8A8878] focus:border-[#C9A84C] focus:outline-none" />
          <select name="package" class="bg-[#141414] border border-[#2A2A22] rounded-lg px-4 py-3 text-[#E8E8E0] focus:border-[#C9A84C] focus:outline-none">
            {event.packages.map((p) => <option value={p.id} class="bg-[#141414]">{p.name}</option>)}
          </select>
          <input name="guests" type="number" min="1" value="1" class="bg-[#141414] border border-[#2A2A22] rounded-lg px-4 py-3 text-[#E8E8E0] focus:border-[#C9A84C] focus:outline-none" />
          <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <button type="submit" class="cta-red bg-[#FF3B3B] text-white ev-display text-2xl tracking-wide px-6 py-4 rounded-xl">Pre-book</button>
        </form>
        <p id="prebook-msg" class="mt-3 text-sm text-[#C9A84C] hidden" role="status" aria-live="polite"></p>

        <a href={waHref} target="_blank" rel="noopener" data-umami-event="whatsapp_click" class="mt-4 flex items-center justify-center gap-2 border border-[#2A2A22] px-6 py-3 rounded-lg text-[#E8E8E0] transition-colors hover:border-[#C9A84C]">…or reserve on WhatsApp</a>
      </div>
    </section>

    {event.sponsor.showBranding && (
      <p class="text-center text-[#8A8878] text-sm py-6">{event.sponsor.creditLine}</p>
    )}

    <!-- ─────────── FAQ ─────────── -->
    <section class="relative mx-auto max-w-2xl px-6 py-14">
      <h2 class="ev-display text-4xl mb-6 text-[#E8E8E0]">Good to know</h2>
      <div class="divide-y divide-[#2A2A22] border-y border-[#2A2A22]">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-[#E8E8E0] font-semibold list-none">
              {f.q}
              <span class="text-[#C9A84C] text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-[#8A8878] text-sm mt-2">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- ─────────── FOOTER ─────────── -->
    <footer class="border-t border-[#2A2A22] mt-6">
      <div class="mx-auto max-w-5xl px-6 py-8 text-[#8A8878] text-sm">
        <p class="text-[#E8E8E0] font-semibold">DJ Andre + The Vic Fix</p>
        <p class="mt-2">
          <a href={`mailto:${event.contacts.bookingsEmail}`} class="hover:text-[#C9A84C]">{event.contacts.bookingsEmail}</a>
          · <a href={waHref} target="_blank" rel="noopener" class="hover:text-[#C9A84C]">WhatsApp +91 8105 363636 (Vic)</a>
          · <a href={waAndre} target="_blank" rel="noopener" class="hover:text-[#C9A84C]">+91 99451 94781 (Andre)</a>
        </p>
        <p class="mt-1">
          <a href={event.socials.thevicfix} target="_blank" rel="noopener" class="hover:text-[#C9A84C]">@thevicfix</a>
          · <a href={event.socials.djvic} target="_blank" rel="noopener" class="hover:text-[#C9A84C]">@djvicofficial</a>
        </p>
        <p class="mt-1">{event.venue.name}, {event.venue.city} · <a href={event.venue.mapsUrl} target="_blank" rel="noopener" class="hover:text-[#C9A84C]">Directions →</a></p>
        <p class="mt-3 text-xs">Drink responsibly. 21+ event.</p>
      </div>
    </footer>
  </div>

  <!-- Sticky mobile CTA bar -->
  <div class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-[#2A2A22] bg-[#0A0A0A]/95 px-4 py-3 backdrop-blur md:hidden">
    <a href={waHref} target="_blank" rel="noopener" data-umami-event="whatsapp_click" class="flex-1 text-center bg-[#FF3B3B] text-white ev-display text-xl tracking-wide py-3 rounded-lg">Reserve on WhatsApp</a>
    <a href="#prebook" class="text-center border border-[#C9A84C]/60 text-[#C9A84C] ev-display text-xl tracking-wide px-5 py-3 rounded-lg">Pre-book</a>
  </div>
</Layout>

<style>
  .ev-display { font-family: 'Bebas Neue', sans-serif; font-weight: 400; letter-spacing: 0.02em; }
  .ev-italic { font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-weight: 400; }
  .ev summary::-webkit-details-marker { display: none; }

  /* Atmospheric gold glow behind the hero */
  .hero-glow {
    position: absolute; inset: -20% 0 auto 0; height: 90%;
    background: radial-gradient(60% 55% at 50% 25%, rgba(201, 168, 76, 0.18), rgba(201, 168, 76, 0.05) 45%, transparent 70%);
    pointer-events: none;
  }
  /* Film grain */
  .grain {
    position: absolute; inset: 0; pointer-events: none; opacity: 0.06; z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }
  .poster { box-shadow: 0 0 0 1px rgba(201, 168, 76, 0.25), 0 30px 90px -20px rgba(201, 168, 76, 0.25); }
  .pkg-featured { box-shadow: 0 0 60px -12px rgba(201, 168, 76, 0.35); }
  .cta-red { box-shadow: 0 10px 40px -10px rgba(255, 59, 59, 0.55); transition: transform 0.25s ease, filter 0.25s ease; }
  .cta-red:hover { transform: translateY(-2px); filter: brightness(1.08); }

  /* Scroll reveals */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1 !important; transform: none !important; transition: none; }
  }
</style>

<script>
  // ── Scroll reveals ──
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealEls = document.querySelectorAll('.reveal');
  if (reduce) {
    revealEls.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
      { threshold: 0.12 }
    );
    revealEls.forEach((el) => io.observe(el));
  }

  // ── Countdown to kickoff ──
  const target = new Date('2026-07-20T00:30:00+05:30').getTime();
  const units: Record<string, HTMLElement | null> = {
    days: document.querySelector('[data-unit="days"]'),
    hrs: document.querySelector('[data-unit="hrs"]'),
    min: document.querySelector('[data-unit="min"]'),
    sec: document.querySelector('[data-unit="sec"]'),
  };
  const pad = (n: number) => String(n).padStart(2, '0');
  function tickCountdown() {
    const diff = target - Date.now();
    if (diff <= 0) {
      Object.values(units).forEach((el) => el && (el.textContent = '00'));
      if (units.days) units.days.textContent = "IT'S ON";
      return;
    }
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    if (units.days) units.days.textContent = String(d);
    if (units.hrs) units.hrs.textContent = pad(h);
    if (units.min) units.min.textContent = pad(m);
    if (units.sec) units.sec.textContent = pad(s);
  }
  tickCountdown();
  setInterval(tickCountdown, 1000);

  // ── Package pre-select + scroll ──
  const form = document.getElementById('prebook-form') as HTMLFormElement | null;
  const select = form?.querySelector('select[name="package"]') as HTMLSelectElement | null;
  function selectPkg(id: string) {
    if (select && id) select.value = id;
    document.getElementById('prebook')?.scrollIntoView({ behavior: 'smooth' });
  }
  document.querySelectorAll<HTMLElement>('.pkg-cta').forEach((btn) => {
    btn.addEventListener('click', () => selectPkg(btn.dataset.pkg || ''));
  });
  const q = new URLSearchParams(location.search).get('pkg');
  if (q && select) select.value = q;

  // ── Submit → /api/prebook ──
  const msg = document.getElementById('prebook-msg');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msg) return;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    msg.classList.remove('hidden');
    msg.style.color = '#C9A84C';
    msg.textContent = 'Sending…';
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('/api/prebook', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json();
      if (out.ok) {
        (window as any).umami?.track?.('prebooking_submit');
        form.reset();
        msg.textContent = 'You’re on the list — we’ll confirm your spot on WhatsApp.';
      } else {
        msg.style.color = '#FF3B3B';
        msg.textContent = out.error || 'Something went wrong — please reserve on WhatsApp instead.';
      }
    } catch {
      msg.style.color = '#FF3B3B';
      msg.textContent = 'Something went wrong — please reserve on WhatsApp instead.';
    } finally {
      btn.disabled = false;
    }
  });
</script>
