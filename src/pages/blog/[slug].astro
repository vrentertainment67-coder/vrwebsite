---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import { getBlogPosts, getBlogPost } from '@/lib/content';
import { marked } from 'marked';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getBlogPost(slug!);
if (!post) return Astro.redirect('/blog');

const html = post.body_md ? marked.parse(post.body_md) : '';
const fmt = (d: string | null) =>
  d ? new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(d)) : '';
---

<Layout title={`${post.title} — VR Entertainment`} description={post.excerpt ?? post.title} path={`/blog/${post.slug}`} type="article">
  <PageHero eyebrow={fmt(post.published_at)} title={post.title} subtitle={post.excerpt ?? undefined} />

  <article class="mx-auto max-w-2xl px-5 py-16 lg:px-10">
    {post.cover_image && (
      <img src={post.cover_image} alt={post.title} loading="lazy" class="mb-10 w-full rounded-lg border border-hairline" />
    )}
    <div class="post-body" set:html={html} />
    <div class="rule mt-12 pt-8">
      <a href="/blog" class="btn-text">← All posts</a>
    </div>
  </article>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>

<style>
  /* Minimal prose for DB-authored markdown, dark editorial. */
  .post-body :global(h2) { font-family: var(--font-display); font-weight: 800; font-size: 1.75rem; letter-spacing: -0.02em; margin: 2rem 0 0.75rem; color: var(--color-ink); }
  .post-body :global(h3) { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; margin: 1.5rem 0 0.5rem; color: var(--color-ink); }
  .post-body :global(p) { color: var(--color-grey); line-height: 1.75; margin: 0 0 1.1rem; }
  .post-body :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .post-body :global(ul), .post-body :global(ol) { color: var(--color-grey); margin: 0 0 1.1rem 1.25rem; line-height: 1.75; }
  .post-body :global(li) { margin: 0.3rem 0; }
  .post-body :global(blockquote) { border-left: 2px solid var(--color-accent); padding-left: 1rem; margin: 1.5rem 0; color: var(--color-ink); font-style: italic; }
  .post-body :global(img) { border-radius: 0.5rem; border: 1px solid var(--color-hairline); margin: 1.5rem 0; }
  .post-body :global(code) { font-family: var(--font-mono); font-size: 0.85em; background: var(--color-surface); border: 1px solid var(--color-hairline); border-radius: 4px; padding: 0.1rem 0.35rem; }
</style>
