---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import { SITE } from '@/lib/site';

const schema = [
  {
    '@type': 'PodcastSeries',
    name: 'The Vic Fix',
    url: `${SITE.url}/the-vic-fix`,
    description: 'India’s nightlife, on the record — a documentary platform on the people who run the night.',
    author: { '@id': `${SITE.url}/#vikas-naik` },
  },
];
---

<Layout
  title="The Vic Fix — India’s nightlife, on the record"
  description="Our own documentary platform on the people who run the night. It’s how we prove what we can build for you."
  path="/the-vic-fix"
  schema={schema}
>
  <PageHero
    eyebrow="Our platform"
    title="The Vic Fix — India’s nightlife, on the record."
    subtitle="A documentary platform on the people who run the night. It’s how we prove what we can build for you."
  >
    <div class="mt-8 flex flex-wrap items-center gap-5">
      <a href={SITE.socials.youtube} target="_blank" rel="noopener" class="btn">Watch</a>
      <a href="/contact" class="btn-text">Partner with the show →</a>
    </div>
  </PageHero>

  <!-- TODO(VIC): embed real reels/teasers + episode grid -->
  <section class="mx-auto max-w-[1400px] px-5 py-16 lg:px-10">
    <div class="grid gap-6 md:grid-cols-3">
      {[1, 2, 3].map((n) => (
        <div data-reveal class="group relative flex aspect-video items-center justify-center overflow-hidden rounded-lg border border-hairline bg-surface">
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-ink text-paper transition-transform group-hover:scale-110">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
          <span class="mono-label absolute bottom-3 left-3">Episode {n} · TODO</span>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
