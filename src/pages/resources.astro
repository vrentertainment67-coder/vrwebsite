---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import AuditForm from '@/components/AuditForm.astro';
---

<Layout
  title="Resources — VR Entertainment"
  description="Free audits and growth playbooks for venues, artists and hospitality brands."
  path="/resources"
>
  <PageHero
    eyebrow="Resources"
    title="Tools to grow the night."
    subtitle="Start with a free audit. More playbooks coming soon."
  />

  <section id="free-audit" class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-2">
      <div data-reveal>
        <p class="mono-label">// Free audit</p>
        <h2 class="mt-4 font-display text-[clamp(2rem,5vw,3.5rem)] font-extrabold leading-[0.98] tracking-tight text-ink">
          Get the free audit.
        </h2>
        <p class="mt-5 max-w-md text-lg text-grey">
          We’ll show you the three things hurting your bookings or footfall right now. No call required.
        </p>
      </div>
      <div data-reveal data-reveal-delay="0.1"><AuditForm /></div>
    </div>
  </section>

  <!-- TODO(VIC): guides / templates / downloads grid -->
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
