---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import LeadForm from '@/components/LeadForm.astro';
import { SEGMENTS, SERVICES } from '@/lib/site';

export function getStaticPaths() {
  return SEGMENTS.map((s) => ({ params: { segment: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const emphasis = SERVICES.slice(0, 4);
---

<Layout
  title={`${s.title} — VR Entertainment`}
  description={`${s.pitch} Websites, content and growth systems for ${s.title.toLowerCase()}, built from inside the nightlife industry.`}
  path={`/who-we-help/${s.slug}`}
>
  <PageHero eyebrow="Who we help" title={s.title} subtitle={s.pitch}>
    <div class="mt-8 flex flex-wrap items-center gap-5">
      <a href="/contact" class="btn">Book a Strategy Call</a>
      <a href="#audit" class="btn-text">Get a free audit →</a>
    </div>
  </PageHero>

  <!-- TODO(VIC): segment-specific proof + copy. Scaffold below. -->
  <section class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10 lg:py-28">
    <p class="mono-label" data-reveal>// What we build for you</p>
    <div class="mt-8">
      {emphasis.map((svc, i) => (
        <ServiceCard title={svc.title} blurb={svc.blurb} href={`/services/${svc.slug}`} index={`0${i + 1}`} />
      ))}
    </div>
  </section>

  <section id="audit" class="border-t border-hairline bg-surface">
    <div class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10">
      <p class="mono-label" data-reveal>// Let’s talk</p>
      <h2 class="mt-4 font-display text-[clamp(2rem,5vw,3.5rem)] font-light leading-[0.98] tracking-normal text-ink" data-reveal>
        Ready to own the night?
      </h2>
      <p class="mt-4 max-w-xl text-lg text-grey" data-reveal>Tell us what you want to grow. We’ll come back with a plan.</p>
      <div class="mt-8" data-reveal data-reveal-delay="0.1"><LeadForm source="service-page" segment={s.segment} /></div>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
