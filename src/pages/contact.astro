---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';
import { SITE } from '@/lib/site';
---

<Layout
  title="Contact — Book a Strategy Call — VR Entertainment"
  description="Book a strategy call, request a free audit, or message us on WhatsApp. Let’s build the brand that owns your night."
  path="/contact"
>
  <PageHero
    eyebrow="Let’s talk"
    title="Book a strategy call."
    subtitle="Send a message or WhatsApp us. We take three new clients a quarter — make it count."
  />

  <section class="mx-auto grid max-w-7xl gap-12 px-5 py-16 lg:grid-cols-2 lg:px-8">
    <!-- Talk to us — WhatsApp-first direct contact -->
    <div data-reveal>
      <h2 class="font-display text-3xl text-off-white">Talk to us</h2>
      <p class="mt-3 max-w-md text-warm-grey">
        Fastest way to reach us is WhatsApp — we usually reply same day. Prefer email or a call? Those work too.
      </p>

      <a
        href={SITE.whatsapp}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-flex items-center gap-3 rounded-md bg-[#25D366] px-6 py-4 font-display text-xl tracking-wide text-near-black transition-transform hover:scale-[1.02]"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.01c-.24.68-1.42 1.32-1.95 1.36-.5.04-1.13.21-3.66-.76-3.07-1.21-5.04-4.36-5.19-4.56-.15-.2-1.25-1.66-1.25-3.17s.79-2.25 1.07-2.56c.28-.31.61-.39.81-.39.2 0 .41 0 .58.01.19.01.44-.07.69.53.24.6.83 2.07.9 2.22.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.18-.31.4-.45.53-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.02 1.12.99 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.2.73-.85.92-1.14.19-.29.39-.24.65-.15.26.1 1.66.78 1.95.93.29.15.48.22.55.34.07.12.07.7-.17 1.38z"/>
        </svg>
        WhatsApp us
      </a>

      <div class="mt-8 border-t border-white/10 pt-6 text-sm text-warm-grey">
        <p><a href={`tel:${SITE.nap.phoneE164}`} class="hover:text-gold">{SITE.nap.phoneDisplay}</a></p>
        <p><a href={`mailto:${SITE.email}`} class="hover:text-gold">{SITE.email}</a></p>
        <address class="mt-3 not-italic">
          {SITE.nap.business}, {SITE.nap.street}, {SITE.nap.locality} {SITE.nap.postalCode}
        </address>
      </div>
    </div>

    <!-- Message form → /api/lead → Supabase `leads` -->
    <div data-reveal data-reveal-delay="0.15">
      <h2 class="font-display text-3xl text-off-white">Send a message</h2>
      <p class="mt-3 text-warm-grey">Tell us what you want to grow. We’ll be in touch within one business day.</p>
      <div class="mt-5"><LeadForm source="contact" /></div>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
