---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/data/site';

const title = 'Start a project | VR Entertainment';
const description =
  'Book a 20-minute call with VR Entertainment. Tell us about your venue, brand or artist project and we’ll show you what an intelligent website would do for it.';
---

<Layout title={title} description={description} path="/contact">
  <Header variant="inner" active="/contact" />
  <main id="main" class="contact">
    <div class="eyebrow vr-rise">
      <span class="vr-pulse dot" aria-hidden="true"></span>Start a project
    </div>
    <h1 class="h1 vr-rise-2">Let’s build something that <span class="it accent">answers.</span></h1>
    <p class="lead vr-rise-2">
      Tell us about your venue, brand or artist project. We reply within one business day — or message
      us on WhatsApp for the fastest route.
    </p>

    <div class="grid vr-rise-3">
      <form id="enq-form" class="form">
        <div class="field">
          <label for="e-name">Name</label>
          <input id="e-name" name="name" required autocomplete="name" />
        </div>
        <div class="two">
          <div class="field">
            <label for="e-email">Email</label>
            <input id="e-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="e-phone">Phone / WhatsApp</label>
            <input id="e-phone" name="phone" type="tel" autocomplete="tel" />
          </div>
        </div>
        <div class="field">
          <label for="e-type">What are you?</label>
          <select id="e-type" name="business_type">
            <option value="venue">Venue</option>
            <option value="hospitality">Hospitality group</option>
            <option value="artist">Artist / DJ</option>
            <option value="events">Events brand</option>
            <option value="other">Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="e-msg">What do you want it to do?</label>
          <textarea id="e-msg" name="message" rows="4"></textarea>
        </div>
        <input type="text" name="company" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <button type="submit" class="btn btn-solid">Send →</button>
        <p class="msg" id="enq-msg" role="status" aria-live="polite"></p>
      </form>

      <aside class="direct">
        <p class="mono label">Direct</p>
        <a href={SITE.whatsapp} target="_blank" rel="noopener" class="d-link">WhatsApp →</a>
        <a href={`mailto:${SITE.email}`} class="d-link">{SITE.email}</a>
        <a href={`tel:${SITE.phoneE164}`} class="d-link">{SITE.phoneDisplay}</a>
        <p class="addr muted">{SITE.address.line}</p>
      </aside>
    </div>
  </main>
  <Footer variant="inner" />

  <script>
    const form = document.getElementById('enq-form') as HTMLFormElement | null;
    const msg = document.getElementById('enq-msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!msg) return;
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      msg.style.color = 'var(--muted)';
      msg.textContent = 'Sending…';
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch('/api/enquiry', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...data, source: 'contact' }),
        });
        const out = await res.json();
        if (out.ok) {
          (window as any).umami?.track?.('enquiry');
          form.reset();
          msg.style.color = 'var(--accent)';
          msg.textContent = 'Got it — we’ll be in touch within one business day.';
        } else {
          msg.style.color = 'var(--accent)';
          msg.textContent = out.error || 'Something went wrong — please WhatsApp us instead.';
        }
      } catch {
        msg.textContent = 'Network error — please WhatsApp us instead.';
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</Layout>

<style>
  .contact { max-width: var(--container); margin: 0 auto; padding: 72px var(--gutter) var(--section-y); display: flex; flex-direction: column; gap: 28px; }
  .eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--muted); display: flex; align-items: center; gap: 10px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .h1 { margin: 0; font-weight: 500; font-size: clamp(48px, 8vw, 128px); line-height: 0.92; letter-spacing: var(--tracking-display); max-width: 1100px; }
  .it { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: var(--tracking-serif); }
  .accent { color: var(--accent); }
  .lead { margin: 0; max-width: 560px; font-size: var(--text-lead); line-height: 1.5; font-weight: 300; color: var(--muted); }

  .grid { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 48px 80px; }
  .form { flex: 1 1 480px; display: flex; flex-direction: column; gap: 16px; max-width: 620px; }
  .two { display: flex; flex-wrap: wrap; gap: 16px; }
  .two .field { flex: 1 1 200px; }
  .field { display: flex; flex-direction: column; gap: 7px; }
  .field label { font-size: 14px; color: var(--muted); }
  .form input, .form select, .form textarea {
    font: inherit;
    font-size: 17px;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: transparent;
    color: inherit;
    width: 100%;
    box-sizing: border-box;
  }
  .form input:focus-visible, .form select:focus-visible, .form textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .form textarea { resize: vertical; }
  .hp { position: absolute; left: -9999px; }
  .btn { text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: var(--btn-h); padding: 0 30px; border-radius: var(--radius-pill); font-size: 16px; border: 0; cursor: pointer; width: fit-content; }
  .btn-solid { background: var(--fg); color: var(--bg); font-weight: 500; }
  .msg { margin: 4px 0 0; font-size: 14px; min-height: 1.2em; color: var(--muted); }

  .direct { flex: 1 1 240px; display: flex; flex-direction: column; gap: 14px; align-content: start; }
  .mono { font-family: var(--font-mono); }
  .label { font-size: 12px; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--muted); margin: 0 0 6px; }
  .d-link { font-size: 22px; letter-spacing: -0.02em; text-decoration: none; width: fit-content; }
  .muted { color: var(--muted); }
  .addr { font-size: 14px; margin: 12px 0 0; }
</style>
