---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Digital Marketing | VR Entertainment" description="Strategy-first digital marketing for artists, venues, labels, and hospitality brands in India's entertainment economy.">
  <section class="bg-background px-6 py-[100px] lg:px-8">
    <div class="mx-auto grid max-w-[1200px] gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-terracotta font-[300]">DIGITAL MARKETING</p>
        <h1 class="mt-6 font-display text-[52px] leading-tight text-text-primary">We grow entertainment brands.</h1>
        <p class="mt-6 text-[18px] leading-[1.8] text-text-secondary font-[300]">Strategy-first digital marketing for artists, venues, labels, and hospitality brands in India's entertainment economy.</p>
      </div>
      <div class="rounded-[6px] border border-border bg-surface p-10">
        <p class="text-[14px] uppercase tracking-[0.18em] text-text-tertiary">Marketing with cultural depth</p>
        <p class="mt-6 text-[16px] leading-[1.8] text-text-primary font-[300]">We adapt to entertainment rhythms, spikes, fandom and creator culture so campaigns feel native, not generic.</p>
      </div>
    </div>
  </section>

  <section class="bg-surface px-6 py-[100px] lg:px-8">
    <div class="mx-auto grid max-w-[1200px] gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-[28px] font-display text-text-primary">Services</h2>
        <div class="mt-8 space-y-4 text-[16px] leading-8 text-text-secondary font-[300]">
          <p>Social media strategy and management</p>
          <p>Content calendar and publishing</p>
          <p>Paid social (Meta, YouTube)</p>
          <p>Audience growth and community management</p>
          <p>Analytics, reporting, and optimisation</p>
          <p>Influencer identification and coordination</p>
        </div>
      </div>
      <div class="rounded-[6px] border border-border bg-background p-10">
        <h2 class="text-[28px] font-display text-text-primary">Why entertainment is different</h2>
        <p class="mt-6 text-[16px] leading-[1.8] text-text-secondary font-[300]">Entertainment audiences behave differently to retail or service audiences. The market is cultural, event-driven and tied to fandom. We build campaigns with that nuance in mind.</p>
      </div>
    </div>
    <div class="mx-auto mt-12 max-w-[840px] rounded-[6px] border border-border bg-background p-10">
      <p class="text-[16px] leading-[1.8] text-text-primary font-[500]">Retainers from ₹40,000/month.</p>
      <p class="mt-4 text-[16px] leading-[1.8] text-text-secondary font-[300]">Minimum 3-month engagement.</p>
    </div>
  </section>

  <section class="bg-background px-6 py-[100px] lg:px-8">
    <div class="mx-auto max-w-[840px] text-center">
      <a href="/contact?type=marketing" class="inline-flex rounded-[8px] border border-accent px-8 py-4 text-[14px] font-[500] text-accent hover:bg-accent hover:text-background transition duration-300 ease-in-out">Request a Proposal →</a>
    </div>
  </section>
</Layout>
