---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';

// TODO(VIC): confirm inclusions + pricing before publish.
const includes = [
  'Brand identity + press kit for the venue',
  'Cinematic website with events + bookings',
  'Local SEO so the city finds you',
  'Launch content + reels package',
  'Opening-night marketing campaign',
];
---

<Layout
  title="Venue Launch Kit — VR Entertainment"
  description="Everything a new venue needs to open loud: brand, site, local SEO, content and a launch campaign."
  path="/venue-launch-kit"
>
  <PageHero
    eyebrow="Productized offer"
    title="Venue Launch Kit."
    subtitle="Fill the room from night one. Brand, site, content and a launch campaign — done together."
  >
    <div class="mt-8 flex flex-wrap items-center gap-5">
      <a href="#start" class="btn">Launch my venue</a>
      <a href="/who-we-help/venues-and-clubs" class="btn-text">For venues &amp; clubs →</a>
    </div>
  </PageHero>

  <section class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10 lg:py-28">
    <p class="mono-label" data-reveal>// What’s inside</p>
    <ul class="mt-8 max-w-2xl">
      {includes.map((item, i) => (
        <li data-reveal class="flex items-baseline gap-4 border-b border-hairline py-4 text-lg text-ink">
          <span class="section-index">0{i + 1}</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <p class="mono-label mt-6" data-reveal>// Pricing &amp; timeline: TODO — confirm before publish</p>
  </section>

  <section id="start" class="border-t border-hairline bg-surface">
    <div class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10">
      <h2 class="font-display text-[clamp(2rem,5vw,3.25rem)] font-light tracking-normal text-ink" data-reveal>Let’s open loud.</h2>
      <div class="mt-8" data-reveal data-reveal-delay="0.1"><LeadForm source="service-page" segment="venue" /></div>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
