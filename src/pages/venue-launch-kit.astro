---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';

// TODO: confirm inclusions + pricing before publish.
const includes = [
  'Brand identity + press kit for the venue',
  'Cinematic website with events + bookings',
  'Local SEO so the city finds you',
  'Launch content + reels package',
  'Opening-night marketing campaign',
];
---

<Layout
  title="Venue Launch Kit — VR Entertainment"
  description="Everything a new venue needs to open loud: brand, site, local SEO, content and a launch campaign."
  path="/venue-launch-kit"
>
  <PageHero
    eyebrow="Productized offer"
    title="Venue Launch Kit."
    subtitle="Fill the room from night one. Brand, site, content and a launch campaign — done together."
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="#start" class="btn-cta">Launch my venue</a>
      <a href="/who-we-help/venues-and-clubs" class="btn-ghost">For venues &amp; clubs</a>
    </div>
  </PageHero>

  <section class="mx-auto max-w-3xl px-5 py-16 lg:px-8">
    <div data-reveal>
      <p class="eyebrow mb-5">What’s inside</p>
      <ul class="mt-4 space-y-3">
        {
          includes.map((item) => (
            <li class="flex items-start gap-3 text-lg text-off-white">
              <span class="mt-1 text-gold">✓</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-warm-grey">Pricing &amp; timeline: TODO — confirm before publish.</p>
    </div>
  </section>

  <section id="start" class="bg-deep-black py-16">
    <div class="mx-auto flex max-w-3xl flex-col items-center px-5 text-center lg:px-8" data-reveal>
      <h2 class="font-display text-4xl text-off-white">Let’s open loud.</h2>
      <div class="mt-8 flex justify-center"><LeadForm source="service-page" segment="venue" /></div>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/reveal.ts';
</script>
