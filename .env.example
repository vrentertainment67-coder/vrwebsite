# ─────────────────────────────────────────────────────────────
# VR Entertainment — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Supabase (server-side writes via service role key)
SUPABASE_URL=https://srvznhpfgynwxqmpfdmf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__set_in_env__        # server only — do NOT prefix PUBLIC_

# Optional: only if any safe client-side reads are ever needed
PUBLIC_SUPABASE_URL=https://srvznhpfgynwxqmpfdmf.supabase.co

# Calendly scheduling link embedded on /contact (e.g. https://calendly.com/your-handle/strategy-call)
PUBLIC_CALENDLY_URL=__set_in_env__

# Optional: MailerLite newsletter forwarding (server only)
MAILERLITE_API_KEY=__set_in_env__
