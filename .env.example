# ─────────────────────────────────────────────────────────────
# VR Entertainment — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Supabase (server-side writes via the service role key)
SUPABASE_URL=https://srvznhpfgynwxqmpfdmf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__set_in_env__        # server only — never prefix PUBLIC_

# Umami analytics (cookieless — no cookie banner needed). Leave blank to disable.
PUBLIC_UMAMI_SCRIPT_URL=__set_in_env__          # e.g. https://cloud.umami.is/script.js
PUBLIC_UMAMI_WEBSITE_ID=__set_in_env__          # the Umami website UUID

# Notifications on new score/enquiry leads via ntfy.sh (optional, keyless).
NTFY_TOPIC=__set_in_env__                       # pick a private topic string

# Phase 3 only (concierge + Site Score summary) — not needed for Phase 1
ANTHROPIC_API_KEY=__set_in_env__
